// 記事「品質を動かしたのはツールとプロンプトだった」用。
// 原文の処理順序に従う:
//   registered tools -> availability and permission filtering
//   -> current agent-mode filtering -> progressive-discovery facade -> model-visible tools
// 初版は facade -> commands -> manual -> filtered の順で描いており、
// 権限検査が最後に来るため本文と矛盾していた（査読 R-02）。
//
// 4つのコマンド（list/search/load/operation）は grafana_exec のものであり、
// datasource_exec は別の構文を持つ。両入口の後ろに同じ4コマンド表を置くと
// 構文を混同させるので、grafana_exec の側にだけコマンド体系を示す。
//
// 縦組み（TB）にする。横組みでは1898px になり、本文幅（約700px）に対して
// 広すぎて文字が読めない（査読 R-20）。
digraph tool_facade {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB,
    compound=true, splines=ortho,
    nodesep=0.4, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  registered [
    fillcolor="#FDE1EC", color="#AA3E6A",
    label=<<b>登録済みのツール</b><br align="left"/><font face="JetBrains Mono">51</font> 個の定義<br align="left"/>推定約 <font face="JetBrains Mono">54,500</font> トークン<br align="left"/>>
  ];

  filtering [
    fillcolor="#D2F3DF", color="#038435",
    label=<<b>絞り込み</b><br align="left"/>権限と可用性<br align="left"/>エージェントのモード<br align="left"/>>
  ];

  facade [
    fillcolor="#FFE9D6", color="#AB5A13",
    label=<<b>2つの入口</b><br align="left"/><font face="JetBrains Mono">grafana_exec</font><br align="left"/><font face="JetBrains Mono">datasource_exec</font><br align="left"/>常時提示は約 <font face="JetBrains Mono">504</font> トークン<br align="left"/>>
  ];

  commands [
    shape=plain, style="",
    label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#736B10">
        <tr><td align="left" bgcolor="#FFFEED"><b><font face="JetBrains Mono">grafana_exec</font> の流れ</b></td></tr>
        <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">list</font> と <font face="JetBrains Mono">search</font> は必要なときだけ</td></tr>
        <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">load</font> で領域のマニュアルを読む</td></tr>
        <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">operation</font> で実行する</td></tr>
      </table>>
  ];

  visible [
    fillcolor="#F7DDFC", color="#9430A9",
    label=<<b>モデルに見えるツール</b><br align="left"/>使えない能力は<br align="left"/>木にも現れない<br align="left"/>>
  ];

  registered -> filtering;
  filtering -> facade;
  facade -> visible;
  facade -> commands [style=dashed, color="#8A8A8A"];
}
