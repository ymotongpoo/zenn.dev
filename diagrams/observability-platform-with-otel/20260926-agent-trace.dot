// AIエージェントアプリのトレース構造
digraph agent_trace {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.45, ranksep=0.5, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  root [label=<<b>GET /ask</b><br align="left"/>HTTPサーバーのスパン<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  agent [label=<<b>invoke_agent support-agent</b><br align="left"/>gen_ai.agent.name<br align="left"/>gen_ai.conversation.id<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  chat1 [label=<<b>chat stub-model-1</b><br align="left"/>推論: ツールを選ぶ<br align="left"/>gen_ai.usage.input_tokens など<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  tool [label=<<b>execute_tool search_orders</b><br align="left"/>gen_ai.tool.name<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  http [label=<<b>HTTP GET</b><br align="left"/>ツールが社内APIを呼ぶ<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  backend [label=<<b>GET /inventory</b><br align="left"/>backendの通常のスパン<br align="left"/>ここから先は普通の分散トレース<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];
  chat2 [label=<<b>chat stub-model-1</b><br align="left"/>推論: 回答を組み立てる<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];

  root -> agent;
  agent -> chat1;
  agent -> tool;
  tool -> http;
  http -> backend;
  agent -> chat2;
}
