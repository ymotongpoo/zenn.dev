// OpAMPによるフリート管理の構成
digraph opamp_topology {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.6, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  git [label=<<b>設定リポジトリ（Git）</b><br align="left"/>真実の源。PRとCI検査を通る<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];
  server [label=<<b>OpAMPサーバー</b><br align="left"/>最後の配達区間を担う<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];

  subgraph cluster_node {
    label=<<b>各ノード</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#4A4A4A"; bgcolor="#F3F3F3"; fontcolor="#343434"; margin=14;
    supervisor [label=<<b>Supervisor</b><br align="left"/>接続を保ち、設定を合成し<br align="left"/>Collectorを起動、監視する<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
    collector [label=<<b>Collector</b><br align="left"/>opampextension入りの<br align="left"/>社内ビルド（30章）<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
    supervisor -> collector [xlabel=" 起動と設定適用"];
  }

  git -> server [xlabel=" 取り込み"];
  server -> supervisor;
  // 報告の内容（ヘルス、実効設定、APPLIED/FAILED）はキャプションと本文にある。
  // ここにラベルを置くと、配布の辺との隙間を取り合ってクラスタの枠線に乗る。
  supervisor -> server [style=dashed, color="#8A8A8A", fontcolor="#4A4A4A"];
}
