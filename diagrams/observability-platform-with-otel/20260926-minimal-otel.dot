// OpenTelemetryの最小構成
digraph minimal_otel {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_apps {
    label=<<b>計装されたサービス群</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AB5A13"; bgcolor="#FFF5ED"; fontcolor="#783F0E"; margin=14;
    svcA [label=<<b>サービスA</b><br align="left"/>計装がトレース、メトリクス、<br align="left"/>ログを作る<br align="left"/>リソース属性で名乗る<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
    svcB [label=<<b>サービスB</b><br align="left"/>同じく計装済み<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  }

  collector [label=<<b>Collector</b><br align="left"/>テレメトリーを受信し、加工し、送信する中継プロセス<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  backend [label=<<b>バックエンド</b><br align="left"/>保存、検索、可視化を行う<br align="left"/>>];

  // svcA から Collector へ下りる線は svcB の右脇を通る。ラベルは
  // nudge_xlabel_from_edge.py が線から離す方向へ押し出すが、その際
  // クラスタの枠を越えないよう制限がかかる。
  svcA -> svcB [style=dashed, color="#8A8A8A", fontcolor="#4A4A4A"];
  svcA:se -> collector [xlabel=" OTLP"];
  svcB -> collector [xlabel=" OTLP"];
  collector -> backend;
}
