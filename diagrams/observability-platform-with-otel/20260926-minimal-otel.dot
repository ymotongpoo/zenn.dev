// OpenTelemetryの最小構成
digraph minimal_otel {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  subgraph cluster_apps {
    label=<<b>計装されたサービス群</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#38638F"; bgcolor="#EFF5FB"; fontcolor="#2E4D6E"; margin=14;
    svcA [label=<<b>サービスA</b><br align="left"/>計装がトレース、メトリクス、<br align="left"/>ログを作る<br align="left"/>resource属性で名乗る<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];
    svcB [label=<<b>サービスB</b><br align="left"/>同じく計装済み<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];
  }

  collector [label=<<b>Collector</b><br align="left"/>テレメトリーを受信し、加工し、送信する中継プロセス<br align="left"/>>, fillcolor="#E9DFF2", color="#75589C"];
  backend [label=<<b>バックエンド</b><br align="left"/>保存、検索、可視化を行う<br align="left"/>>];

  svcA -> svcB [style=dashed, color="#7C8DA3", fontcolor="#5B6B7E", label=" リクエスト\l （propagatorがトレースの文脈を載せる）\l"];
  svcA -> collector [label=" OTLP"];
  svcB -> collector [label=" OTLP"];
  collector -> backend;
}
