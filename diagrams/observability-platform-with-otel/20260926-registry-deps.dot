// 公式レジストリと社内レジストリの参照関係
digraph registry_deps {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.6, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  division [label=<<b>事業部レジストリ（任意）</b><br align="left"/>全社の上にさらに重ねられる<br align="left"/>（依存は最大10階層）<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  internal [label=<<b>社内レジストリ</b><br align="left"/>com.example.* の属性を定義<br align="left"/>公式属性はrefで参照して上書き<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  official [label=<<b>公式semconvレジストリ</b><br align="left"/>タグ固定（例: v1.44.0）<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];
  genai [label=<<b>GenAI規約レジストリ</b><br align="left"/>リリースがないためコミットSHA固定<br align="left"/>採用日と上流schema_urlを記録<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];

  division -> internal [xlabel=" 依存"];
  internal -> official [xlabel=" 依存（schema_urlを明記）"];
  internal -> genai [xlabel=" 依存（60章）"];
}
