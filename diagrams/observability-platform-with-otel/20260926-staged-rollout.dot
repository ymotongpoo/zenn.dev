// リモート設定の段階的ロールアウト
digraph staged_rollout {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  merged [label=<<b>設定のマージ</b><br align="left"/>CIで実効設定を検査済み<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];
  canary [label=<<b>canary（1台）</b><br align="left"/>適用結果とテレメトリー到達を確認<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  partial [label=<<b>一部のグループ</b><br align="left"/>エクスポーター失敗率と流量を監視<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  full [label=<<b>フリート全体</b>>, fillcolor="#D2F3DF", color="#038435"];
  halt [label=<<b>展開停止と再配布</b><br align="left"/>修正版を配り直す<br align="left"/>起動失敗の自動ロールバックだけに頼らない<br align="left"/>>, fillcolor="#FDE1EC", color="#AA3E6A"];

  merged -> canary;
  canary -> partial [xlabel=" 到達確認OK"];
  partial -> full [xlabel=" 監視OK"];
  canary -> halt [style=dashed, color="#AA3E6A", fontcolor="#7A2C4C", xlabel=" 異常"];
  partial -> halt [style=dashed, color="#AA3E6A", fontcolor="#7A2C4C", xlabel=" 異常"];

  { rank=same; partial; halt; }
}
