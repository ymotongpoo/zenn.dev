// リファレンス実装 otel-platform-blueprint の全体構成
digraph blueprint_overview {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.45, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_services {
    label=<<b>services（otelinit組み込み）</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AB5A13"; bgcolor="#FFF5ED"; fontcolor="#783F0E"; margin=14;
    frontend [label="frontend", fillcolor="#FFE9D6", color="#AB5A13"];
    backendsvc [label="backend", fillcolor="#FFE9D6", color="#AB5A13"];
    aiapp [label="ai-app", fillcolor="#FFE9D6", color="#AB5A13"];
  }

  uninstr [label=<<b>uninstrumented</b><br align="left"/>計装コードなし<br align="left"/>otelcでコンパイル時計装（3章）<br align="left"/>>, style="rounded,filled,dashed", fillcolor="#E4E4E4", color="#4A4A4A"];

  subgraph cluster_agent {
    label=<<b>Supervisor管理のエージェント</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#4A4A4A"; bgcolor="#F3F3F3"; fontcolor="#343434"; margin=14;
    agent [label=<<b>otelcol-internal</b><br align="left"/>OCBビルド。opampextension入り<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  }

  opamp [label=<<b>opamp-server</b><br align="left"/>remote-configs/ を配布<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  gateway [label=<<b>ゲートウェイ（otelcol-internal）</b><br align="left"/>テイルサンプリング、redaction<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];

  subgraph cluster_backend {
    label=<<b>Grafanaスタック</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#736B10"; bgcolor="#FFFEED"; fontcolor="#4D470B"; margin=14;
    tempo [label="Tempo\n（トレース）", fillcolor="#FFFCD7", color="#736B10"];
    mimir [label="Mimir\n（メトリクス）", fillcolor="#FFFCD7", color="#736B10"];
    loki [label="Loki\n（ログ）", fillcolor="#FFFCD7", color="#736B10"];
  }

  grafana [label=<<b>Grafana</b><br align="left"/>横断的な可視化<br align="left"/>>];
  weaverreg [label=<<b>registry/ + Weaver</b><br align="left"/>sdk/semconv/ を生成<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];

  frontend -> agent;
  backendsvc -> agent;
  aiapp -> agent;
  uninstr -> agent [xlabel=" otelcビルド後"];
  agent -> gateway;
  gateway -> tempo;
  gateway -> mimir;
  gateway -> loki;
  tempo -> grafana;
  mimir -> grafana;
  loki -> grafana;

  // 点線の意味（設定と生成物の配布先）はキャプションが述べている。
  // ラベルを置くとクラスタの枠線や矢印の線に乗る。
  opamp -> agent [style=dashed, color="#9430A9", fontcolor="#6A2278"];
  weaverreg -> frontend [style=dashed, color="#9430A9", fontcolor="#6A2278"];
}
