// OpenTelemetry Operatorによる自動計装の注入
digraph operator_injection {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  dev [label=<<b>開発チーム</b><br align="left"/>Podのannotationに<br align="left"/>inject-java: "true" を書くだけ<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  apiserver [label=<<b>Kubernetes APIサーバー</b><br align="left"/>Pod作成リクエストを受ける<br align="left"/>>];
  webhook [label=<<b>Operatorのadmission webhook</b><br align="left"/>Instrumentationリソース（基盤が用意）を参照し<br align="left"/>Podの定義を書き換える<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  pod [label=<<b>変更後のPod</b><br align="left"/>エージェントを置くinit containerと<br align="left"/>OTEL_* 環境変数が注入されている<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];
  running [label=<<b>アプリ起動</b><br align="left"/>コード変更なしで計装済み<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];

  dev -> apiserver [xlabel=" Pod作成"];
  apiserver -> webhook [xlabel=" フック"];
  webhook -> pod [xlabel=" 注入"];
  pod -> running;
}
