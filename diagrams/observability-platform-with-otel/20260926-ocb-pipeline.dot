// OCBによるカスタムCollectorのビルドパイプライン
digraph ocb_pipeline {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  manifest [label=<<b>manifest.yaml</b><br align="left"/>使うコンポーネントのgomodを列挙<br align="left"/>組織で使えるものの宣言でもある<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];

  subgraph cluster_ci {
    label=<<b>CI</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AB5A13"; bgcolor="#FFF5ED"; fontcolor="#783F0E"; margin=14;
    ocb [label=<<b>OCB（builder）</b><br align="left"/>Goコードを生成してビルド<br align="left"/>バージョン整合を検査<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
    binary [label=<<b>otelcol-internal</b><br align="left"/>必要な部品だけの社内バイナリ<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];
    validate [label=<<b>validate</b><br align="left"/>エージェントとゲートウェイの設定を<br align="left"/>ビルドしたバイナリで検証<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  }

  image [label=<<b>コンテナイメージ</b>>, fillcolor="#D2F3DF", color="#038435"];
  deploy [label=<<b>配備先</b><br align="left"/>エージェント（4章）、Supervisor管理下（5章）<br align="left"/>>];

  manifest -> ocb;
  ocb -> binary;
  binary -> validate;
  validate -> image;
  image -> deploy;
}
