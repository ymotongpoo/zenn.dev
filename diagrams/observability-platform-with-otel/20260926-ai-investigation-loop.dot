// AIによる障害調査のループ
digraph ai_investigation_loop {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.5, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  alert [label=<<b>アラート</b><br align="left"/>対象サービスと時間帯を特定<br align="left"/>>, fillcolor="#FDE1EC", color="#AA3E6A"];
  query [label=<<b>クエリの生成と実行</b><br align="left"/>トレース、メトリクス、ログを横断<br align="left"/>ここの正確さが調査全体を決める<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  hypo [label=<<b>仮説</b><br align="left"/>「このデプロイ以降、この<br align="left"/>エンドポイントだけエラー率上昇」<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  verify [label=<<b>裏付けクエリ</b>>, fillcolor="#FFE9D6", color="#AB5A13"];
  report [label=<<b>報告</b><br align="left"/>根拠のテレメトリーへのリンク付き<br align="left"/>検証責任は人間に残る<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];

  registry [label=<<b>レジストリ</b><br align="left"/>属性の意味のカタログ<br align="left"/>（weaver registry mcp）<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];

  alert -> query;
  query -> hypo;
  hypo -> verify;
  verify -> query [xlabel=" 追加調査"];
  verify -> report [xlabel=" 確証"];

  registry -> query [style=dashed, color="#9430A9", fontcolor="#6A2278", xlabel=" 正しい属性名を参照\l"];

  { rank=same; query; registry; }
}
