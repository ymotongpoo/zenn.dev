// AI調査エージェントの二種類のMCP接続
digraph two_mcp {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.55, ranksep=0.6, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  ai [label=<<b>AI調査エージェント</b>>, fillcolor="#FFE9D6", color="#AB5A13"];

  subgraph cluster_schema {
    // タイトルは短く保つ。長いと枠幅を超えて隣のクラスタと重なり、
    // 後ろのタイトルが前の枠の塗りで隠れて読めなくなる。
    // 読ませてよい範囲と統制の条件はキャプションで述べる。
    label=<<b>スキーマを読む</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#9430A9"; bgcolor="#FCF0FE"; fontcolor="#6A2278"; margin=14;
    regmcp [label=<<b>registry MCP</b><br align="left"/>weaver registry mcp<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
    registry [label=<<b>社内レジストリ</b><br align="left"/>属性の意味と規約<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];
    regmcp -> registry;
  }

  subgraph cluster_data {
    label=<<b>実データを読む</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AB5A13"; bgcolor="#FFF5ED"; fontcolor="#783F0E"; margin=14;
    telmcp [label=<<b>telemetry MCP</b><br align="left"/>バックエンド固有のツール定義<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
    backend [label=<<b>観測バックエンド</b><br align="left"/>トレース、メトリクス、ログ<br align="left"/>>];
    telmcp -> backend;
  }

  // ラベルは置かない。2本ともクラスタの角と縦線に挟まれた狭い場所へ
  // 配置され、枠線か線に必ず触れる（ELK はラベル位置を自分で決めるので
  // 空白での押し出しも効かない）。読む対象の違いはキャプションが述べる。
  ai -> regmcp;
  ai -> telmcp;
}
