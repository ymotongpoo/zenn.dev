// セルフサービステレメトリー基盤の3本柱
digraph three_pillars {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.6, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_pillar1 {
    label=<<b>柱1: 計装の配布（10章、20章）</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AB5A13"; bgcolor="#FFF5ED"; fontcolor="#783F0E"; margin=14;
    app [label=<<b>アプリケーション</b><br align="left"/>SDKディストリビューション<br align="left"/>またはゼロコード計装<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  }

  subgraph cluster_pillar2 {
    label=<<b>柱2: Collector層の管理（30章、40章）</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AB5A13"; bgcolor="#FFF5ED"; fontcolor="#783F0E"; margin=14;
    agent [label=<<b>agent Collector</b><br align="left"/>ノードごと。メタデータ付加<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
    gateway [label=<<b>gateway Collector</b><br align="left"/>組織の方針を実装<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  }

  backend [label=<<b>OTLP対応バックエンド</b><br align="left"/>保存、検索、可視化<br align="left"/>>];

  registry [label=<<b>柱3: セマンティック規約レジストリ（50章）</b><br align="left"/>属性の名前と意味の単一の定義<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];

  app -> agent [xlabel=" OTLP"];
  agent -> gateway;
  gateway -> backend;

  registry -> app [style=dashed, color="#9430A9", fontcolor="#6A2278", xlabel=" 生成した属性定数を同梱\l"];
  registry -> gateway [style=dashed, color="#9430A9", fontcolor="#6A2278", xlabel=" 変換設定を導出\l"];
}
