// 中央集権モデルとセルフサービスモデルの対比
// @divider: between-clusters
digraph central_vs_selfservice {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.4, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  // 辺のラベル（依頼、利用、整備）は置かない。同じ語が3本ずつ並ぶだけで、
  // 矢じりや隣の箱に被る。矢印の意味はキャプションが述べ、「整備」は
  // プラットフォームチームのノード内に書いてある。
  subgraph cluster_central {
    label=<<b>中央集権モデル</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AA3E6A"; bgcolor="#FEF2F7"; fontcolor="#7A2C4C"; margin=14;
    tA [label="チームA"]; tB [label="チームB"]; tC [label="チームC"];
    central [label=<<b>中央チーム</b><br align="left"/>レビュー、設定変更、命名相談が集中<br align="left"/>処理能力はそのままで、依頼だけ増える<br align="left"/>>, fillcolor="#FDE1EC", color="#AA3E6A"];
    tA -> central;
    tB -> central;
    tC -> central;
  }

  subgraph cluster_selfservice {
    label=<<b>セルフサービスモデル</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#038435"; bgcolor="#EBFAF1"; fontcolor="#025E26"; margin=14;
    platform [label=<<b>プラットフォームチーム</b><br align="left"/>配布物と検査を整備する<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];
    artifacts [label=<<b>配布物</b><br align="left"/>ディストリビューション、Collector、レジストリ<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];
    sA [label="チームA"]; sB [label="チームB"]; sC [label="チームC"];
    platform -> artifacts;
    sA -> artifacts;
    sB -> artifacts;
    sC -> artifacts;
  }

  // 2つのモデルは別物であることを示すため、間隔を空けて区切り線を挟む。
  // 区切り線は冒頭の `@divider: between-clusters` が指示し、
  // draw_divider.py がSVG後処理で引く。
  //
  // 辺で引こうとして失敗した手を記録しておく。不可視ノード2つを
  // rank=same で並べて間を実線で結ぶ方法（divL -> divR）は、線が中央に
  // 短く浮くだけでなく、両クラスタの端へ揃えようと tA/tC への不可視辺を
  // 足した時点でチームの並び順が崩れ（A B C が B A C になる）、線自体も
  // 折れた。ランクを跨ぐ「装飾としての線」は dot のレイアウトモデルの
  // 外にあるので、後処理で描くのが正しい。
  // 上下の間隔は不可視辺で作る。左端を揃えようと tA -> platform で繋ぐと、
  // その辺がランク内の順序決定に影響してチームの並びが B C A に崩れる。
  // 枠の左端を揃えることより並び順が正しいことのほうが重要なので、
  // 揃えるのは諦める。
  central -> platform [style=invis, minlen=3];
}
