// agentとgatewayの2段トポロジー
digraph agent_gateway {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_node1 {
    label=<<b>ノード1</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#4A4A4A"; bgcolor="#F3F3F3"; fontcolor="#343434"; margin=14;
    app1 [label="アプリ", fillcolor="#FFE9D6", color="#AB5A13"];
    agent1 [label=<<b>エージェント</b><br align="left"/>受け口の提供<br align="left"/>ホストのメタデータ付加<br align="left"/>設定は薄く、全ノードで同一<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
    app1 -> agent1;
  }

  // agentの役割は全ノードで同一。図の2箱は同じものを表す

  subgraph cluster_node2 {
    label=<<b>ノード2</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#4A4A4A"; bgcolor="#F3F3F3"; fontcolor="#343434"; margin=14;
    app2 [label="アプリ", fillcolor="#FFE9D6", color="#AB5A13"];
    agent2 [label=<<b>エージェント</b><br align="left"/>受け口の提供<br align="left"/>ホストのメタデータ付加<br align="left"/>設定は薄く、全ノードで同一<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
    app2 -> agent2;
  }

  lb [label=<<b>振り分け層（tail sampling運用時のみ）</b><br align="left"/>同じtrace IDを同じゲートウェイへ<br align="left"/>>, fillcolor="#FCF0FE", color="#9430A9", style="rounded,filled,dashed"];

  subgraph cluster_gateway {
    label=<<b>ゲートウェイ（組織の方針を実装）</b>>;
    labeljust="l"; style="rounded"; penwidth=1.6;
    color="#AB5A13"; bgcolor="#FFF5ED"; fontcolor="#783F0E"; margin=14;
    gw [label=<<b>ゲートウェイ Collector群</b><br align="left"/>tail sampling<br align="left"/>属性の統制（PII削除、変換）<br align="left"/>ルーティングとバックエンド認証<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  }

  backend [label=<<b>OTLP対応バックエンド</b>>];

  agent1 -> lb;
  agent2 -> lb;
  lb -> gw;
  gw -> backend;
}
