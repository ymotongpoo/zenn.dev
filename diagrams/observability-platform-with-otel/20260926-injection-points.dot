// 計装の注入ポイント比較
digraph injection_points {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.6, ranksep=0.5, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#E4E4E4", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  src [label=<<b>ソースコード</b>>, fillcolor="#FFE9D6", color="#AB5A13"];
  build [label=<<b>ビルド</b>>, fillcolor="#FFE9D6", color="#AB5A13"];
  runtime [label=<<b>実行時（プロセス内）</b>>, fillcolor="#FFE9D6", color="#AB5A13"];
  kernel [label=<<b>カーネル</b>>, fillcolor="#FFE9D6", color="#AB5A13"];

  manual [label=<<b>手動計装</b><br align="left"/>SDKディストリビューション（2章）<br align="left"/>コード変更が必要。表現力は最大<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  otelc [label=<<b>ビルド時計装</b><br align="left"/>otelc。ビルドコマンドを差し替える<br align="left"/>特権不要。Goの第一候補<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  agentbased [label=<<b>実行時エージェント</b><br align="left"/>Javaのjavaagent、Pythonの実行時パッチなど<br align="left"/>動的なランタイムを持つ言語向け<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  ebpf [label=<<b>eBPF</b><br align="left"/>OBI。プロセスの外から観測する<br align="left"/>特権が必要。言語横断<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];

  src -> build -> runtime -> kernel;

  manual -> src [style=dashed, color="#9430A9"];
  otelc -> build [style=dashed, color="#9430A9"];
  agentbased -> runtime [style=dashed, color="#9430A9"];
  ebpf -> kernel [style=dashed, color="#9430A9"];

  { rank=same; src; manual; }
  { rank=same; build; otelc; }
  { rank=same; runtime; agentbased; }
  { rank=same; kernel; ebpf; }
}
