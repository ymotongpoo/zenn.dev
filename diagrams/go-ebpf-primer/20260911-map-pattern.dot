// マップで入口と出口をつなぐ
digraph map_pattern {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];
  ranksep=0.9;

  entry [label=<<b>入口のフック</b><br align="left"/>いまの時刻を書き込む<br align="left"/>>,
         fillcolor="#FFE9D6", color="#AB5A13"];

  map [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#736B10">
      <tr><td colspan="2" align="left" bgcolor="#FFFEED"><b>マップ</b>（カーネルが持つキーバリューストア）</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><b>キー</b></td><td align="left" bgcolor="#FFFCD7">入口と出口を結びつける識別子</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><b>値</b></td><td align="left" bgcolor="#FFFCD7">開始時刻</td></tr>
    </table>>];

  exit [label=<<b>出口のフック</b><br align="left"/>開始時刻を読み、差を所要時間とする<br align="left"/>>,
        fillcolor="#FFE9D6", color="#AB5A13"];

  entry -> map [label=" 先に起きるイベントが書く", penwidth=1.8];
  map -> exit [label=" 後に起きるイベントが読む", penwidth=1.8];
}
