// goroutine の親子追跡と traceparent 注入
digraph context_propagation {
  graph [
    rankdir=TB, splines=ortho, compound=true,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.7, ranksep=0.7,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_svca {
    label=<<b>サービスA（1プロセス）</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AB5A13"; fontcolor="#783F0E"; bgcolor="#FFF5ED";

    recv [label=<<b>受信 goroutine</b>　トレース開始>, fillcolor="#FFE9D6", color="#AB5A13"];
    proc [label=<<b>処理 goroutine</b>>, fillcolor="#FFE9D6", color="#AB5A13"];
    send [label=<<b>送信 goroutine</b><br align="left"/><font face="JetBrains Mono">writeSubset</font> で直列化<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];

    recv -> proc [label=" newproc1 で親子を記録 "];
    proc -> send [label=" 遡れるのは6段まで "];
  }

  p1 [label=<<b>経路1</b><br align="left"/><font face="JetBrains Mono">bufio.Writer</font> のバッファに<br align="left"/><font face="JetBrains Mono">bpf_probe_write_user</font> で追記<br align="left"/>>,
      fillcolor="#F7DDFC", color="#9430A9"];
  p2 [label=<<b>経路2</b><br align="left"/><font face="JetBrains Mono">sk_msg</font> で送出される<br align="left"/>バイト列を伸ばす<br align="left"/>>,
      fillcolor="#F7DDFC", color="#9430A9"];
  lock [label=<<font face="Poppins"><b>kernel lockdown / Secure Boot</b></font>>, fillcolor="#FDE1EC", color="#AA3E6A"];
  svcb [label=<<b>サービスB</b>　traceparent を受け取る>, fillcolor="#E4E4E4"];

  { rank=same; p1; p2; }

  send -> p1;
  send -> p2;
  lock -> p1 [style=dashed, color="#AA3E6A", arrowhead=tee, xlabel="経路1を無効化"];
  p1 -> svcb;
  p2 -> svcb;
}
