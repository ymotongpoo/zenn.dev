// 静的リンクされたGoバイナリと動的リンク
digraph static_link {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  cprog [pos="160,400!", label=<<b>Cで書いたプログラム</b><br align="left"/>自分のコードだけを持つ<br align="left"/>>, fillcolor="#EDF1F5"];
  L0 [pos="235,332!", shape=plaintext, style="", label="実行時に解決する依存"];
  libc [pos="160,260!", label=<<b>libc.so</b>（共有ライブラリ）<br align="left"/>起動時に結び付けられ、置き場所は環境で変わる<br align="left"/>>,
        fillcolor="#F3E8CE", color="#96742E"];

  goprog [pos="580,260!", label=<<b>Goで書いたプログラム</b><br align="left"/>自分のコード、標準ライブラリ、ランタイムを<br align="left"/>1つのバイナリに同梱する<br align="left"/>>,
          fillcolor="#D9E7F4", color="#38638F"];

  e1 [pos="160,130!", shape=point, width=0.01, style=invis];
  e2 [pos="580,130!", shape=point, width=0.01, style=invis];
  j  [pos="370,130!", shape=point, width=0.01, style=invis];

  kernel [pos="370,60!", label=<<b>カーネル</b>>, fillcolor="#E9DFF2", color="#75589C"];

  L1 [pos="222,180!", shape=plaintext, style="", label="システムコール"];
  L2 [pos="466,180!", shape=plaintext, style="", label="システムコール（libcを挟まない）"];

  cprog -> libc;
  libc -> e1 [dir=none];
  goprog -> e2 [dir=none];
  e1 -> j [dir=none];
  e2 -> j [dir=none];
  j -> kernel;
}
