// 静的リンクされたGoバイナリと動的リンク
digraph static_link {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  cprog [label=<<b>Cで書いたプログラム</b><br align="left"/>自分のコードだけを持つ<br align="left"/>>, fillcolor="#E4E4E4"];
  libc [label=<<font face="JetBrains Mono"><b>libc.so</b></font>（共有ライブラリ）<br align="left"/>起動時に結び付けられ、置き場所は環境で変わる<br align="left"/>>,
        fillcolor="#FFF0D8", color="#996719"];

  goprog [label=<<b>Goで書いたプログラム</b><br align="left"/>自分のコード、標準ライブラリ、ランタイムを<br align="left"/>1つのバイナリに同梱する<br align="left"/>>,
          fillcolor="#D8E5FF", color="#1D4EB2"];

  kernel [label=<<b>カーネル</b>>, fillcolor="#E8E3FF", color="#5846B2"];

  cprog -> libc;
  libc -> kernel;
  goprog -> kernel;

  { rank=same; libc; goprog; }
}
