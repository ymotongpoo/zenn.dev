// フィールドを1つ足すと後ろがずれる
digraph struct_band {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];
  ranksep=1.0;

  v1 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#1D4EB2">
      <tr><td colspan="2" align="left" bgcolor="#EEF4FF"><font face="JetBrains Mono"><b>streamV1</b></font>（合計40バイト）</td></tr>
      <tr><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">+0 〜 +15</font></td><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">ctx any</font>（型ポインタ8 ＋ データポインタ8）</td></tr>
      <tr><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">+16 〜 +19</font></td><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">id uint32</font></td></tr>
      <tr><td align="left" bgcolor="#FFF0D8"><font face="JetBrains Mono">+20 〜 +23</font></td><td align="left" bgcolor="#FFF0D8">詰め物</td></tr>
      <tr><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">+24 〜 +39</font></td><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">method string</font>（ポインタ8 ＋ 長さ8）</td></tr>
    </table>>];

  v2 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AA3E6A">
      <tr><td colspan="2" align="left" bgcolor="#FEF2F7"><font face="JetBrains Mono"><b>streamV2</b></font>（合計48バイト）</td></tr>
      <tr><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">+0 〜 +15</font></td><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">ctx any</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">+16 〜 +23</font></td><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">cancel func()</font>（足したフィールド）</td></tr>
      <tr><td align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">+24 〜 +27</font></td><td align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">id uint32</font>（16から24へ動いた）</td></tr>
      <tr><td align="left" bgcolor="#FFF0D8"><font face="JetBrains Mono">+28 〜 +31</font></td><td align="left" bgcolor="#FFF0D8">詰め物</td></tr>
      <tr><td align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">+32 〜 +47</font></td><td align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">method string</font>（24から32へ動いた）</td></tr>
    </table>>];

  v1 -> v2 [label=" ctx の後ろに cancel を1つ足す", penwidth=1.8];
}
