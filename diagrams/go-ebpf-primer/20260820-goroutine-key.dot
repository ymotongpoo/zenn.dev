// uprobe 発火時に OBI が読むもの
digraph goroutine_key {
  graph [
    rankdir=TB, splines=ortho, compound=true,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.5, ranksep=0.6,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  fire [label=<<b>uprobe 発火</b>　レジスタの写し <font face="JetBrains Mono">pt_regs</font>>, fillcolor="#E4E4E4"];

  subgraph cluster_regs {
    label=<<b>OBI が読むレジスタ</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#1D4EB2"; fontcolor="#143880"; bgcolor="#EEF4FF";

    r14 [label=<<font face="JetBrains Mono"><b>R14</b></font>（<font face="JetBrains Mono">amd64</font>）/ <font face="JetBrains Mono"><b>R28</b></font>（<font face="JetBrains Mono">arm64</font>）<br align="left"/>g 構造体の先頭アドレス<br align="left"/>>,
         fillcolor="#D8E5FF", color="#1D4EB2"];
    args [label=<<font face="JetBrains Mono"><b>AX, BX, CX, …</b></font><br align="left"/>関数の引数<br align="left"/>>,
          fillcolor="#D8E5FF", color="#1D4EB2"];
    { rank=same; r14; args; }
  }

  key [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#5846B2">
      <tr><td align="left" bgcolor="#F5F3FF"><font face="JetBrains Mono"><b>go_addr_key_t</b></font>（goroutine の識別子）</td></tr>
      <tr><td align="left" bgcolor="#E8E3FF"><font face="JetBrains Mono">addr = 0xc000102000</font></td></tr>
      <tr><td align="left" bgcolor="#E8E3FF"><font face="JetBrains Mono">pid&nbsp;&nbsp;= 12345</font></td></tr>
    </table>>];

  gstruct [label=<<b>g 構造体の中身</b><br align="left"/><font face="JetBrains Mono">stack.lo / stack.hi / goid …</font><br align="left"/>>,
           style="rounded,filled,dashed", fillcolor="#FEF2F7", color="#AA3E6A"];

  values [label=<<b>引数の値</b><br align="left"/>HTTPメソッド、URLなど<br align="left"/>>, fillcolor="#E4E4E4"];

  { rank=same; key; gstruct; values; }

  fire -> r14;
  fire -> args;
  r14 -> key [penwidth=1.8];
  r14 -> gstruct [style=dashed, color="#AA3E6A", arrowhead=odot];
  args -> values;
}
