// オフセットを2つの情報源から集める
digraph offset_resolution {
  graph [
    rankdir=TB, splines=ortho,
    nodesep=0.9, ranksep=0.5, pad=0.25,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white"
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  bin [label=<<b>計装対象のバイナリ</b>>, fillcolor="#E4E4E4"];
  dwarf [label=<<b>DWARFデバッグ情報を読む</b><br align="left"/>コンパイラが書き残したフィールドの位置<br align="left"/>>,
         fillcolor="#FFE9D6", color="#AB5A13"];

  got [label=<<b>読めたフィールド</b><br align="left"/>目の前のバイナリの事実なので追従が要らない<br align="left"/>>,
       fillcolor="#D2F3DF", color="#038435"];
  miss [label=<<b>読めなかったフィールド</b>>, fillcolor="#FFFCD7", color="#736B10"];

  json [label=<<b>ビルド情報から版を割り出し<br align="left"/><font face="JetBrains Mono">offsets.json</font> を引く</b><br align="left"/><font face="JetBrains Mono">go-offsets-tracker</font> が自動更新する表<br align="left"/>その版以下で最新の記録を返す<br align="left"/>>,
        fillcolor="#FFFCD7", color="#736B10"];

  use [label=<<b>1つのオフセット表として使う</b>>, fillcolor="#E4E4E4"];
  fail [label=<<b>記録が無ければ、その項目だけ欠ける</b>>, fillcolor="#FDE1EC", color="#AA3E6A"];

  bin -> dwarf;
  dwarf -> got;
  dwarf -> miss;
  bin -> json [style=dashed, color="#8A8A8A"];
  miss -> json;
  got -> use [penwidth=1.8];
  json -> use;
  json -> fail [style=dashed, color="#AA3E6A"];

  { rank=same; got; miss; got -> miss [style=invis]; }


}
