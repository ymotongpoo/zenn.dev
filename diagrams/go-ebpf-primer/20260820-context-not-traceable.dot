// レジスタは読めるが、文脈は追えない
digraph context_not_traceable {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  top [pos="505,470!", label=<<b>uprobeが発火した瞬間のOBI</b>>, fillcolor="#EDF1F5"];

  j  [pos="505,425!", shape=point, width=0.01, style=invis];
  jl [pos="170,425!", shape=point, width=0.01, style=invis];
  jr [pos="830,425!", shape=point, width=0.01, style=invis];

  can [pos="170,340!", label=<<b>できる</b>：レジスタから引数の値を読む<br align="left"/>HTTPメソッドやURLをその場で取り出せる<br align="left"/>>,
       fillcolor="#D6E8D6", color="#3F6E3F"];
  cannot [pos="505,340!", label=<<b>できない</b>：ctx が渡っていく先を追い続ける<br align="left"/>>,
          fillcolor="#F5DEDE", color="#A04848"];
  alt [pos="830,340!", label=<<b>代わりの手がかり</b><br align="left"/>goroutineの親子関係を記録して辿る<br align="left"/>>,
       fillcolor="#D9E7F4", color="#38638F"];

  L1 [pos="745,388!", shape=plaintext, style="", label="値を解読せずに済ませる"];

  reasons [pos="505,180!", shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#A04848">
      <tr><td align="left" bgcolor="#FBEFEF"><b>追えない理由</b></td></tr>
      <tr><td align="left" bgcolor="#F5DEDE">ctx はインターフェース値で、中身は別の場所にある</td></tr>
      <tr><td align="left" bgcolor="#F5DEDE">引数の位置は関数ごとに違う</td></tr>
      <tr><td align="left" bgcolor="#F5DEDE">goroutineをまたいで渡されることがある</td></tr>
    </table>>];

  top -> j [dir=none];
  j -> jl [dir=none];
  j -> jr [dir=none];
  jl -> can;
  j -> cannot [style=dashed, color="#A04848", arrowhead=tee];
  jr -> alt;
  cannot -> reasons [style=dotted, color="#7C8DA3", arrowhead=none];
}
