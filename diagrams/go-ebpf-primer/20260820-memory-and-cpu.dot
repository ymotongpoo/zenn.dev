// プロセスのメモリとCPU
digraph memory_and_cpu {
  graph [
    layout=neato, inputscale=72, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  regs [pos="210,250!", shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#1D4EB2">
      <tr><td colspan="2" align="left" bgcolor="#EEF4FF"><b>CPUのレジスタ</b>（中の小さな入れ物）</td></tr>
      <tr><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">RAX、RBX、RCX …</font></td><td align="left" bgcolor="#D8E5FF">計算に使う汎用レジスタ</td></tr>
      <tr><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">SP</font></td><td port="sp" align="left" bgcolor="#D8E5FF">スタックの先端のアドレス</td></tr>
      <tr><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">PC</font></td><td port="pc" align="left" bgcolor="#D8E5FF">次に実行する命令のアドレス</td></tr>
    </table>>];

  mem [pos="556,250!", shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#4A4A4A">
      <tr><td colspan="2" align="left" bgcolor="#F3F3F3"><b>1つのプロセスに見えているメモリ</b>（仮想アドレス空間）</td></tr>
      <tr><td colspan="2" align="left" bgcolor="#FFFFFF"><i>高いアドレス</i></td></tr>
      <tr><td port="stk" align="left" bgcolor="#D8E5FF"><b>スタック</b></td>
          <td align="left" bgcolor="#D8E5FF">関数の引数とローカル変数</td></tr>
      <tr><td align="left" bgcolor="#FFF0D8"><b>ヒープ</b></td>
          <td align="left" bgcolor="#FFF0D8">明示的に確保する領域</td></tr>
      <tr><td align="left" bgcolor="#E8E3FF"><b>データ</b></td>
          <td align="left" bgcolor="#E8E3FF">グローバル変数や定数</td></tr>
      <tr><td port="txt" align="left" bgcolor="#D2F3DF"><b>テキスト</b></td>
          <td align="left" bgcolor="#D2F3DF">機械語そのもの</td></tr>
      <tr><td colspan="2" align="left" bgcolor="#FFFFFF"><i>低いアドレス</i></td></tr>
    </table>>];

  wa1 [pos="365,233!", shape=point, width=0.01, style=invis];
  wa2 [pos="365,283!", shape=point, width=0.01, style=invis];
  wb1 [pos="380,201!", shape=point, width=0.01, style=invis];
  wb2 [pos="380,181!", shape=point, width=0.01, style=invis];

  regs:sp:e -> wa1 [dir=none];
  wa1 -> wa2 [dir=none];
  wa2 -> mem:stk:w;
  regs:pc:e -> wb1 [dir=none];
  wb1 -> wb2 [dir=none];
  wb2 -> mem:txt:w;
}
