// 仮想アドレスと物理メモリ
digraph virtual_to_physical {
  graph [
    rankdir=LR, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  va1 [label=<<b>プロセスAの仮想アドレス空間</b><br align="left"/><font face="JetBrains Mono">0x0000…</font> から連続して見える<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  va2 [label=<<b>プロセスBの仮想アドレス空間</b><br align="left"/><font face="JetBrains Mono">0x0000…</font> から連続して見える<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];

  { rank=same; va1; va2; }

  table_ [label=<<b>カーネルの対応表</b><br align="left"/>仮想アドレス → 物理アドレス<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];

  phys [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#736B10">
      <tr><td align="left" bgcolor="#FFFEED"><b>物理メモリ</b></td></tr>
      <tr><td port="a" align="left" bgcolor="#FFE9D6">Aに割り当てた部分</td></tr>
      <tr><td align="left" bgcolor="#FFFFFF">空き</td></tr>
      <tr><td port="b" align="left" bgcolor="#D2F3DF">Bに割り当てた部分</td></tr>
      <tr><td align="left" bgcolor="#FFFFFF">空き</td></tr>
    </table>>];

  va1 -> table_ [dir=none];
  va2 -> table_ [dir=none];
  table_ -> phys:a:w;
  table_ -> phys:b:w;
}
