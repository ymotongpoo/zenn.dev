// otelcはビルド時にどう割り込むか（通常ビルドとの対比）
digraph otelc_toolexec {
  graph [
    rankdir=TB, compound=true, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.5, ranksep=0.6,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  src [label=<<b>ソースコード</b>（変更なし）>, fillcolor="#E4E4E4"];

  subgraph cluster_l {
    label=<<b>ふつうのビルド</b>>;
    fontcolor="#343434";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#4A4A4A"; bgcolor="#F3F3F3";

    buildL [label=<<font face="JetBrains Mono">go build</font>>, fillcolor="#E4E4E4"];
    binL [label=<<b>バイナリ</b><br align="left"/>計装コードは無い<br align="left"/>>, fillcolor="#E4E4E4"];

    buildL -> binL;
  }

  subgraph cluster_r {
    label=<<b>otelc経由のビルド</b>>;
    fontcolor="#143880";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#1D4EB2"; bgcolor="#EEF4FF";

    buildR [label=<<font face="JetBrains Mono">otelc go build</font>>, fillcolor="#D8E5FF", color="#1D4EB2"];
    wrap [label=<<b>内部で go build に差し替え</b><br align="left"/><font face="JetBrains Mono">-toolexec=&lt;otelc&gt; toolexec</font> を追加<br align="left"/>>,
            fillcolor="#FFF0D8", color="#996719"];
    inject [label=<<b>コンパイル直前に割り込む</b><br align="left"/><font face="JetBrains Mono">net/http</font>・<font face="JetBrains Mono">gRPC</font>・<font face="JetBrains Mono">database/sql</font> などの<br align="left"/>呼び出しに計装コードを注入<br align="left"/>>,
            fillcolor="#FFF0D8", color="#996719"];
    binR [label=<<b>計装済みバイナリ</b><br align="left"/>ソースは1行も変えていない<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];

    buildR -> wrap -> inject -> binR;
  }

  src -> buildL;
  src -> buildR;

  { rank=same; buildL; buildR; }
}
