// ユーザー空間とカーネル空間
digraph user_kernel_space {
  graph [
    rankdir=TB, splines=ortho, compound=true,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.9, ranksep=1.6,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_user {
    label=<<b>ユーザー空間</b>>; labeljust="l"; style="rounded"; penwidth=1.6; margin=14;
    color="#4A4A4A"; fontcolor="#343434"; bgcolor="#F3F3F3";
    app [label=<<b>アプリケーション</b><br align="left"/>Goで書いたプログラムもここで動く<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  }

  subgraph cluster_kernel {
    label=<<b>カーネル空間</b>>; labeljust="l"; style="rounded"; penwidth=1.6; margin=14;
    color="#9430A9"; fontcolor="#6A2278"; bgcolor="#FCF0FE";
    kernel [label=<<b>カーネル</b><br align="left"/>ファイル、ネットワーク、メモリを管理する<br align="left"/>>, fillcolor="#F7DDFC", color="#9430A9"];
  }

  hw [label=<<b>ハードウェア</b><br align="left"/>CPU、メモリ、ディスク、ネットワークカード<br align="left"/>>, fillcolor="#E4E4E4"];

  // 往復する2本は、ポート指定で出入口を左右に寄せて経路そのものを離す。
  // 実線は app/kernel の左寄り、破線は右寄りを通るので、各ラベルは自分の辺が
  // いちばん近い位置に置ける（ラベルだけを動かして隙間に収めようとすると、
  // 隣の辺かクラスタの枠のほうが近くなる）。ranksep はラベルが枠の外に出る
  // 高さを確保するために広げてある。
  app:sw -> kernel:nw [penwidth=1.8, xlabel="システムコールで頼む "];
  kernel:ne -> app:se [style=dashed, color="#8A8A8A", constraint=false, xlabel=" 結果を返す"];
  kernel -> hw [xlabel=" 直接操作する"];
  // この辺はクラスタをまたいで右側を大きく迂回する。ラベルは到達点側に寄せて
  // カーネル空間の枠から離す。
  app -> hw [style=dashed, color="#AA3E6A", arrowhead=tee, headlabel="直接は触れない  ", labeldistance=3.5, labelangle=-14];
}
