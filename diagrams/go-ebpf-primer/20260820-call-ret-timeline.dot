// CALLとRETによる戻りアドレスの受け渡し
digraph call_ret_timeline {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];
  ranksep=0.55;

  s1 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>1. CALLの直前</b>（PC = 0x49e1b3）</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6">スタック</td><td align="left" bgcolor="#FFFFFF">mainのフレームまで</td></tr>
    </table>>];

  s2 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>2. doubleを実行中</b>（CALLがジャンプした先）</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6">スタック</td><td align="left" bgcolor="#FFFCD7">戻りアドレス <font face="JetBrains Mono"><b>0x49e1b8</b></font>（CALLが積んだ）<br align="left"/><font point-size="10">= <font face="JetBrains Mono">0x49e1b3 + 5</font>（CALL命令は5バイト長）</font></td></tr>
    </table>>];

  s3 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>3. RETの直後</b>（PC = 0x49e1b8）</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6">スタック</td><td align="left" bgcolor="#FFFFFF">スロットは取り出されて元どおり</td></tr>
    </table>>];

  s1 -> s2 [label=" CALL main.double\l 　次の命令のアドレスを積んでからジャンプ\l"];
  s2 -> s3 [label=" RET\l 　積まれた値を取り出してそこへジャンプ\l"];
}
