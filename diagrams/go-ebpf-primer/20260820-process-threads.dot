// プロセスとスレッド
digraph process_threads {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_proc {
    label=<<b>1つのプロセス</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#1D4EB2"; fontcolor="#143880"; bgcolor="#EEF4FF";

    t1 [label=<<b>スレッド1</b><br align="left"/>専用のスタック<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];
    t2 [label=<<b>スレッド2</b><br align="left"/>専用のスタック<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];
    t3 [label=<<b>スレッド3</b><br align="left"/>専用のスタック<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];

    shared [label=<<b>共有の領域</b><br align="left"/>ヒープ、データ、テキスト。どのスレッドからも見える<br align="left"/>>, fillcolor="#FFF0D8", color="#996719"];

    { rank=same; t1; t2; t3; }
    t1 -> shared [style=invis];
    t2 -> shared [style=invis];
    t3 -> shared [style=invis];
  }
}
