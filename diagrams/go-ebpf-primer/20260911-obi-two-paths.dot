// OBIの2つの計装経路
digraph obi_two_paths {
  graph [
    rankdir=TB, splines=ortho,
    nodesep=0.5, ranksep=0.4, pad=0.25,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white"
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  obi [label=<<font face="Poppins"><b>OBI</b></font>>, fillcolor="#E4E4E4"];

  proto [label=<<b>プロトコル計装</b><br align="left"/>ソケットを流れるバイト列を解釈<br align="left"/>HTTP/1.1、HTTP/2、gRPC、MySQL、Redis<br align="left"/>>,
         fillcolor="#D2F3DF", color="#038435"];
  lib [label=<<b>ランタイムとライブラリの計装</b><br align="left"/>対象の環境ごとに個別の実装が要る<br align="left"/>ランタイム内部のフックは他言語にもある<br align="left"/>ライブラリの関数計装を持つのはGoだけ<br align="left"/>>,
       fillcolor="#FFE9D6", color="#AB5A13"];

  proto_res [label=<<b>言語に依存しない</b>>, fillcolor="#EBFAF1", color="#038435"];
  lib_res [label=<<b>本書が扱う4つの難所</b><br align="left"/>可動スタック、レジスタABI<br align="left"/>オフセット追従、goroutine<br align="left"/>>,
           fillcolor="#FFF5ED", color="#AB5A13"];

  // obi からの2本は「横に伸びてから真下に折れる」形にする。splines=ortho の
  // 直角配線を dot に任せると、必ず「真下に降りてから横に折れて子の側面に入る」
  // 経路になり、しかも obi の真下に来た子だけが直線になって不揃いに見える。
  // そこで obi と同じランクに不可視の経由点 wl / wr を置き、そこで折る。
  // wl / wr は子が1つずつなので dot の座標決定で子の中心に揃い、
  // 「obi の側面から水平 → 経由点で真下 → 子の上辺」という経路になる。
  // 経由点での継ぎ目は render.sh の elbow.py がふさいで角を丸める。
  // フラットな辺は書いた向きが左右の並び順になるため、wl は wl -> obi と書く
  // （dir=none なので矢じりは出ない。流れは obi から proto / lib へ）。
  wl [shape=point, width=0.01, height=0.01, style=invis, label=""];
  wr [shape=point, width=0.01, height=0.01, style=invis, label=""];

  wl -> obi [dir=none];
  wl -> proto;
  obi -> wr [dir=none, penwidth=1.8];
  wr -> lib [penwidth=1.8];
  proto -> proto_res [style=dashed, color="#8A8A8A"];
  lib -> lib_res [penwidth=1.8];

  { rank=same; wl; obi; wr; }
  { rank=same; proto; lib; }
  { rank=same; proto_res; lib_res; }
}
