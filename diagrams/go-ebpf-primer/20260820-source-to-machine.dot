// ソースから機械語へ、そしてシンボル
digraph source_to_machine {
  graph [
    rankdir=TB, splines=ortho,
    // symtab と insns は rank=same。既定の nodesep(0.25) だと
    // 2つの箱の間の破線矢印が矢じりだけの切れ端に見えるので広げる。
    nodesep=0.8,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  src [label=<<b>Goのソース</b>　<font face="JetBrains Mono">func double(n int) int</font>>, fillcolor="#D6E8D6", color="#3F6E3F"];
  bytes [label=<<b>機械語のバイト列</b>　<font face="JetBrains Mono">48 01 c0 c3</font>>, fillcolor="#F3E8CE", color="#96742E"];

  insns [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#38638F">
      <tr><td colspan="2" align="left" bgcolor="#EFF5FB"><b>命令の並び</b>（1命令ごとにアドレスが付く）</td></tr>
      <tr><td port="head" align="left" bgcolor="#D9E7F4"><font face="JetBrains Mono">0x49e180</font></td>
          <td align="left" bgcolor="#D9E7F4"><font face="JetBrains Mono">ADDQ AX, AX</font></td></tr>
      <tr><td align="left" bgcolor="#D9E7F4"><font face="JetBrains Mono">0x49e183</font></td>
          <td align="left" bgcolor="#D9E7F4"><font face="JetBrains Mono">RET</font></td></tr>
    </table>>];

  symtab [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#96742E">
      <tr><td colspan="2" align="left" bgcolor="#FAF4E4"><b>シンボルテーブル</b></td></tr>
      <tr><td align="left" bgcolor="#F3E8CE"><font face="JetBrains Mono">main.double</font></td>
          <td port="addr" align="left" bgcolor="#F3E8CE"><font face="JetBrains Mono">0x49e180</font></td></tr>
    </table>>];

  src -> bytes;
  bytes -> insns;
  symtab:addr:e -> insns:head:w [style=dashed, color="#7C8DA3"];

  { rank=same; symtab; insns; }
}
