// traceparent をどこへ書き込むか
digraph header_injection {
  graph [
    rankdir=TB, splines=ortho, compound=true,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.6, ranksep=0.7,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  obi [label=<<font face="Poppins"><b>OBI</b></font>（<font face="JetBrains Mono">writeSubset</font> の戻りフック）>, fillcolor="#E8E3FF", color="#5846B2"];

  subgraph cluster_path {
    label=<<b><font face="JetBrains Mono">net/http</font> がリクエストを書き出す経路</b><br align="left"/><br align="left"/>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#1D4EB2"; fontcolor="#143880"; bgcolor="#EEF4FF";

    hdr [label=<<font face="JetBrains Mono"><b>http.Request.Header</b></font><br align="left"/><font face="JetBrains Mono">map[string][]string</font><br align="left"/>>, fillcolor="#E4E4E4"];
    ws [label=<<font face="JetBrains Mono"><b>Header.writeSubset</b></font><br align="left"/>ヘッダを文字列にして積む<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];
    bufw [label=<<font face="JetBrains Mono"><b>bufio.Writer</b></font><br align="left"/>buf にバイト列、n に書き込み済みバイト数<br align="left"/>>, fillcolor="#FFF0D8", color="#996719"];
    sock [label=<<b>ソケット</b>>, fillcolor="#E4E4E4"];

    hdr -> ws;
    ws -> bufw;
    bufw -> sock;
  }

  obi -> hdr [style=dashed, color="#AA3E6A", arrowhead=tee];
  obi -> bufw [color="#5846B2", penwidth=1.8];
}
