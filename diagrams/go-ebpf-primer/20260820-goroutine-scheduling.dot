// OSスレッドとgoroutine
digraph goroutine_scheduling {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.5, ranksep=0.6,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  g1 [label=<<font face="Poppins">goroutine <b>g1</b></font>>, fillcolor="#D9E7F4", color="#38638F"];
  g2 [label=<<font face="Poppins">goroutine <b>g2</b></font>>, fillcolor="#D9E7F4", color="#38638F"];
  g3 [label=<<font face="Poppins">goroutine <b>g3</b></font>>, fillcolor="#D9E7F4", color="#38638F"];
  g4 [label=<<font face="Poppins">goroutine <b>g4</b></font>>, fillcolor="#D9E7F4", color="#38638F"];
  { rank=same; g1; g2; g3; g4; }

  p1 [label=<<font face="Poppins"><b>p</b></font>（実行資源と待ち行列）>, fillcolor="#E9DFF2", color="#75589C"];
  p2 [label=<<font face="Poppins"><b>p</b></font>（実行資源と待ち行列）>, fillcolor="#E9DFF2", color="#75589C"];
  { rank=same; p1; p2; }

  m1 [label=<<font face="Poppins"><b>m</b></font>（OSスレッド）>, fillcolor="#F3E8CE", color="#96742E"];
  m2 [label=<<font face="Poppins"><b>m</b></font>（OSスレッド）>, fillcolor="#F3E8CE", color="#96742E"];
  { rank=same; m1; m2; }

  cpu [label=<<font face="Poppins"><b>CPU</b></font>（コアの数だけ同時に走る）>, fillcolor="#EDF1F5"];

  g1 -> p1;
  g2 -> p1;
  g3 -> p2;
  g4 -> p2;
  p1 -> m1;
  p2 -> m2;
  m1 -> cpu;
  m2 -> cpu;
}
