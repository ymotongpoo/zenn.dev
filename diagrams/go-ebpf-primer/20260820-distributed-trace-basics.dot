// 分散トレースの基本
digraph distributed_trace_basics {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  sa [label=<<b>サービスA</b><br align="left"/>リクエストを受けて処理し、Bを呼ぶ<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  sb [label=<<b>サービスB</b><br align="left"/>受け取ったリクエストを処理する<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];

  rec [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#9430A9">
      <tr><td colspan="3" align="left" bgcolor="#FCF0FE"><b>バックエンドに集まる記録</b></td></tr>
      <tr><td align="left" bgcolor="#F7DDFC"><b>スパン</b></td><td align="left" bgcolor="#F7DDFC"><b>トレースID</b></td><td align="left" bgcolor="#F7DDFC"><b>スパンID と親</b></td></tr>
      <tr><td port="ra" align="left" bgcolor="#FFFFFF">Aの処理</td><td align="left" bgcolor="#FFFFFF"><font face="JetBrains Mono">4bf9…</font></td><td align="left" bgcolor="#FFFFFF"><font face="JetBrains Mono">00f0…</font>（親なし）</td></tr>
      <tr><td port="rb" align="left" bgcolor="#FFFFFF">Bの処理</td><td align="left" bgcolor="#FFFFFF"><font face="JetBrains Mono">4bf9…</font>（同じ）</td><td align="left" bgcolor="#FFFFFF"><font face="JetBrains Mono">b7ad…</font>（親は <font face="JetBrains Mono">00f0…</font>）</td></tr>
    </table>>];

  sa -> sb [penwidth=1.8];
  sa -> rec [style=dashed, color="#8A8A8A", xlabel="記録を送る"];
  sb -> rec [style=dashed, color="#8A8A8A"];
}
