// 分散トレースの基本
digraph distributed_trace_basics {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  sa [pos="180,430!", label=<<b>サービスA</b><br align="left"/>リクエストを受けて処理し、Bを呼ぶ<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];
  L0 [pos="330,368!", shape=plaintext, style="", label="GET /items HTTP/1.1\nTraceparent: 00-4bf9…-00f0…-01"];
  sb [pos="180,300!", label=<<b>サービスB</b><br align="left"/>受け取ったリクエストを処理する<br align="left"/>>, fillcolor="#D6E8D6", color="#3F6E3F"];

  a1 [pos="500,430!", shape=point, width=0.01, style=invis];
  a2 [pos="500,142.7!", shape=point, width=0.01, style=invis];
  b1 [pos="460,300!", shape=point, width=0.01, style=invis];
  b2 [pos="460,110.8!", shape=point, width=0.01, style=invis];

  Ls [pos="580,320!", shape=plaintext, style="", label="記録を送る", fontcolor="#5B6B80"];

  rec [pos="700,160!", shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#75589C">
      <tr><td colspan="3" align="left" bgcolor="#F5F1F9"><b>バックエンドに集まる記録</b></td></tr>
      <tr><td align="left" bgcolor="#E9DFF2"><b>スパン</b></td><td align="left" bgcolor="#E9DFF2"><b>トレースID</b></td><td align="left" bgcolor="#E9DFF2"><b>スパンID と親</b></td></tr>
      <tr><td port="ra" align="left" bgcolor="#FFFFFF">Aの処理</td><td align="left" bgcolor="#FFFFFF">4bf9…</td><td align="left" bgcolor="#FFFFFF">00f0…（親なし）</td></tr>
      <tr><td port="rb" align="left" bgcolor="#FFFFFF">Bの処理</td><td align="left" bgcolor="#FFFFFF">4bf9…（同じ）</td><td align="left" bgcolor="#FFFFFF">b7ad…（親は 00f0…）</td></tr>
    </table>>];

  sa -> sb [penwidth=1.8];
  sa -> a1 [dir=none, style=dashed, color="#7C8DA3"];
  a1 -> a2 [dir=none, style=dashed, color="#7C8DA3"];
  a2 -> rec:ra:w [style=dashed, color="#7C8DA3"];
  sb -> b1 [dir=none, style=dashed, color="#7C8DA3"];
  b1 -> b2 [dir=none, style=dashed, color="#7C8DA3"];
  b2 -> rec:rb:w [style=dashed, color="#7C8DA3"];
}
