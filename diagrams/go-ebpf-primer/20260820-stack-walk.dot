// ランタイムがスタックを辿る手順
digraph stack_walk {
  graph [
    rankdir=TB, splines=ortho,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  old [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#38638F">
      <tr><td colspan="2" align="left" bgcolor="#EFF5FB"><b>旧スタック</b>（上が高いアドレス）</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">…</td><td align="left" bgcolor="#D9E7F4">さらに上の呼び出し元</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE">戻りアドレス</td><td align="left" bgcolor="#F3E8CE">0x4a90f1</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">フレーム</td><td align="left" bgcolor="#D9E7F4">呼び出し元</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE">戻りアドレス</td><td align="left" bgcolor="#F3E8CE">0x49e1b8</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">フレーム</td><td align="left" bgcolor="#D9E7F4">いま実行中の関数</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">SP →</td><td align="left" bgcolor="#D9E7F4">スタックの先端</td></tr>
    </table>>];

  move [label=<<b>0. 新しい領域を確保して</b><br align="left"/><b>　 中身を丸ごとコピーする</b><br align="left"/>>,
        fillcolor="#F3E8CE", color="#96742E"];
  read [label=<<b>1. 戻りアドレスを読む</b>>, fillcolor="#D9E7F4", color="#38638F"];
  lookup [label=<<b>2. どの関数のフレームか引く</b><br align="left"/>.gopclntab で命令アドレス→関数<br align="left"/>>,
          fillcolor="#F3E8CE", color="#96742E"];
  info [label=<<b>3. フレームの大きさと</b><br align="left"/><b>　 ポインタの位置が分かる</b><br align="left"/>>,
        fillcolor="#F3E8CE", color="#96742E"];
  copy [label=<<b>4. そのフレームのポインタを</b><br align="left"/><b>　 新しいアドレスへ書き換える</b><br align="left"/>>,
        fillcolor="#D6E8D6", color="#3F6E3F"];

  new [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#3F6E3F">
      <tr><td align="left" bgcolor="#F0F7F0"><b>新スタック</b>（別の領域、より大きい）</td></tr>
      <tr><td align="left" bgcolor="#D6E8D6">フレームの中身はそのまま</td></tr>
      <tr><td align="left" bgcolor="#D6E8D6">スタックを指すポインタは新しい値に</td></tr>
    </table>>];

  old -> move;
  move -> read;
  read -> lookup;
  lookup -> info;
  info -> copy;
  copy -> new;
  copy -> read [style=dashed, color="#7C8DA3", constraint=false];
}
