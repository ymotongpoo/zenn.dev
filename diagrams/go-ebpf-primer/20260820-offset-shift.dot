// 図4: バージョン間でオフセットがずれる
digraph fig4 {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.6, ranksep=0.75, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  reader [label=<<b>+88 を読む計装コード</b><br align="left"/>オフセットをハードコード<br align="left"/>>,
          fillcolor="#F3E8CE", color="#96742E"];

  v166 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#3F6E3F">
      <tr><td colspan="2" align="left" bgcolor="#F0F7F0"><b>grpc 1.66 の Stream</b></td></tr>
      <tr><td align="left" bgcolor="#D6E8D6">…</td><td align="left" bgcolor="#D6E8D6">…</td></tr>
      <tr><td align="left" bgcolor="#D6E8D6" port="m">+88</td><td align="left" bgcolor="#D6E8D6"><b>method</b></td></tr>
    </table>>];

  v169 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#A04848">
      <tr><td colspan="2" align="left" bgcolor="#FBEFEF"><b>grpc 1.69 の Stream</b>（並びが変わった）</td></tr>
      <tr><td align="left" bgcolor="#D6E8D6">+24</td><td align="left" bgcolor="#D6E8D6"><b>method</b>（本当はここ）</td></tr>
      <tr><td align="left" bgcolor="#F5DEDE">…</td><td align="left" bgcolor="#F5DEDE">…</td></tr>
      <tr><td align="left" bgcolor="#F5DEDE" port="w">+88</td><td align="left" bgcolor="#F5DEDE">別のフィールド</td></tr>
    </table>>];

  bad [label=<<b>クラッシュせず「それらしく動く」</b><br align="left"/>トレースは出るが中身が誤る<br align="left"/>>,
       fillcolor="#F5DEDE", color="#A04848"];

  reader -> v166:m [label=" method が取れる", penwidth=1.6];
  reader -> v169:w [label=" 別のフィールドを\l method として拾う\l", style=dashed, color="#A04848", fontcolor="#7A3030", penwidth=1.6];
  v169:w -> bad [style=dashed, color="#A04848"];

  { rank=same; v166; v169; }
}
