// ランタイムがスタックを辿る手順
digraph stack_walk {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  old [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>旧スタック</b>（上が高いアドレス）</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6">…</td><td align="left" bgcolor="#FFE9D6">さらに上の呼び出し元</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7">戻りアドレス</td><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">0x4a90f1</font></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6">フレーム</td><td align="left" bgcolor="#FFE9D6">呼び出し元</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7">戻りアドレス</td><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">0x49e1b8</font></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6">フレーム</td><td align="left" bgcolor="#FFE9D6">いま実行中の関数</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">SP</font> →</td><td align="left" bgcolor="#FFE9D6">スタックの先端</td></tr>
    </table>>];

  move [label=<<b>0. 新しい領域を確保して</b><br align="left"/><b>　 中身を丸ごとコピーする</b><br align="left"/>>,
        fillcolor="#FFFCD7", color="#736B10"];
  read [label=<<b>1. いまのPCから関数を引く</b><br align="left"/><font face="JetBrains Mono">.gopclntab</font> で命令アドレス→関数<br align="left"/>>,
        fillcolor="#FFFCD7", color="#736B10"];
  lookup [label=<<b>2. フレームの大きさと</b><br align="left"/><b>　 ポインタの位置が分かる</b><br align="left"/>>,
          fillcolor="#FFFCD7", color="#736B10"];
  info [label=<<b>3. そのフレームのポインタを</b><br align="left"/><b>　 新しいアドレスへ書き換える</b><br align="left"/>>,
        fillcolor="#D2F3DF", color="#038435"];
  copy [label=<<b>4. 戻りアドレスを読み、</b><br align="left"/><b>　 呼び出し元の関数を引く</b><br align="left"/>>,
        fillcolor="#FFE9D6", color="#AB5A13"];

  new [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#038435">
      <tr><td align="left" bgcolor="#EBFAF1"><b>新スタック</b>（別の領域、より大きい）</td></tr>
      <tr><td align="left" bgcolor="#D2F3DF">フレームの中身はそのまま</td></tr>
      <tr><td align="left" bgcolor="#D2F3DF">スタックを指すポインタは新しい値に</td></tr>
    </table>>];

  old -> move;
  move -> read;
  read -> lookup;
  lookup -> info;
  info -> copy;
  copy -> new;
  copy -> read [style=dashed, color="#8A8A8A", constraint=false];
}
