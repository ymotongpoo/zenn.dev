// ポインタは番地を値として持つ
digraph pointer_and_address {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    // splines=ortho にすると dot が :v / :a のポートを無視して辺を行の
    // 境界線の上に引いてしまう。この図は2つの箱を横に並べた1本の水平線
    // だけなので、splines=true でも経路は水平のままになる。
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];
  rankdir=LR;
  ranksep=1.0;

  p [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#1D4EB2">
      <tr><td align="left" bgcolor="#EEF4FF"><b>変数 p</b>（ポインタ）</td></tr>
      <tr><td port="v" align="left" bgcolor="#D8E5FF">値: <font face="JetBrains Mono">0x…08</font></td></tr>
      <tr><td align="left" bgcolor="#FFFFFF">アドレス: <font face="JetBrains Mono">0x…40</font></td></tr>
    </table>>];

  x [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#038435">
      <tr><td align="left" bgcolor="#EBFAF1"><b>変数 x</b></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF">値: 42</td></tr>
      <tr><td port="a" align="left" bgcolor="#FFFFFF">アドレス: <font face="JetBrains Mono">0x…08</font></td></tr>
    </table>>];

  // ラベルの箱は辺の上に中央揃えで置かれるため、そのまま書くと文字が矢印に
  // 重なる。末尾に空行（半角スペースだけの行）を足して、見える文字を線より
  // 上へ押し上げている。「pの値がxの番地と一致」の説明はキャプションにある。
  p:v:e -> x:a:w [label="指している\n "];
}
