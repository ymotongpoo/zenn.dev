// 全RET命令へのuprobe
digraph ret_uprobes {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.8, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  decode [label=<<b>1命令ずつデコードする</b>>,
          fillcolor="#F3E8CE", color="#96742E"];

  code [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#38638F">
      <tr><td colspan="2" align="left" bgcolor="#EFF5FB"><b>main.Lookup の機械語</b>（return は1つ）</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">…</td><td align="left" bgcolor="#D9E7F4">…</td></tr>
      <tr><td align="left" bgcolor="#D6E8D6">0x49e050</td><td align="left" bgcolor="#D6E8D6" port="r1"><b>RET</b>（通常の経路）</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">0x49e051</td><td align="left" bgcolor="#D9E7F4">CALL runtime.deferreturn</td></tr>
      <tr><td align="left" bgcolor="#D6E8D6">0x49e060</td><td align="left" bgcolor="#D6E8D6" port="r2"><b>RET</b>（defer 経由の経路）</td></tr>
    </table>>];

  up1 [label=<<b>uprobe</b><br align="left"/>通常の出口<br align="left"/>>, fillcolor="#D6E8D6", color="#3F6E3F"];
  up2 [label=<<b>uprobe</b><br align="left"/>defer 経由の出口<br align="left"/>>, fillcolor="#D6E8D6", color="#3F6E3F"];

  decode -> code [label=" RET のアドレスを\l 洗い出す\l"];
  code:r1:e -> up1 [label=" 置く"];
  code:r2:e -> up2 [label=" 置く"];

  { rank=same; up2 -> up1 [style=invis]; }
}
