// スタック渡しとレジスタ渡し
digraph convention_stack_vs_register {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];
  rankdir=LR;
  nodesep=0.8;

  stackway [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#4A4A4A">
      <tr><td colspan="2" align="left" bgcolor="#F3F3F3"><b>スタック渡し</b>　<font face="JetBrains Mono">f(a, b, c)</font></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">SP+0</font></td><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">a</font></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">SP+8</font></td><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">b</font></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">SP+16</font></td><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">c</font></td></tr>
      <tr><td colspan="2" align="left" bgcolor="#FFFFFF">フレームの決まった位置を見れば読める</td></tr>
    </table>>];

  regway [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#038435">
      <tr><td colspan="2" align="left" bgcolor="#EBFAF1"><b>レジスタ渡し</b>　<font face="JetBrains Mono">f(a, b, c)</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">AX</font></td><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">a</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">BX</font></td><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">b</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">CX</font></td><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">c</font></td></tr>
      <tr><td colspan="2" align="left" bgcolor="#FFFFFF">速いが、対応表を知らないと読めない</td></tr>
    </table>>];

  stackway -> regway [style=invis];
}
