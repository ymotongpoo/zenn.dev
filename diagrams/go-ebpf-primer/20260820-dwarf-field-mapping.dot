// DWARFはソースとメモリを突き合わせる表
digraph dwarf_field_mapping {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];
  rankdir=LR;
  ranksep=0.9;

  src [label=<<b>ソースコードの世界</b><br align="left"/><font face="JetBrains Mono">type record struct {<br align="left"/>　flag bool<br align="left"/>　count int64<br align="left"/>}</font><br align="left"/>>, fillcolor="#D6E8D6", color="#3F6E3F"];

  dwarf [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#75589C">
      <tr><td colspan="2" align="left" bgcolor="#F5F1F9"><font face="Poppins"><b>DWARF</b></font>（<font face="JetBrains Mono">.debug_*</font> セクション）</td></tr>
      <tr><td align="left" bgcolor="#E9DFF2"><font face="JetBrains Mono">record.flag</font></td><td align="left" bgcolor="#E9DFF2">先頭から <font face="JetBrains Mono">+0</font></td></tr>
      <tr><td align="left" bgcolor="#E9DFF2"><font face="JetBrains Mono">record.count</font></td><td align="left" bgcolor="#E9DFF2">先頭から <font face="JetBrains Mono">+8</font></td></tr>
    </table>>];

  mem [label=<<b>実行中のメモリの世界</b><br align="left"/>バイト列とアドレスだけ<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];

  src -> dwarf [label=" コンパイラが\l 書き残す\l"];
  dwarf -> mem [label=" 名前から\l バイト位置を引く\l", style=dashed, color="#7C8DA3", fontcolor="#5B6B80"];
}
