// HTTPのバイト列と、traceparent を差し込む2つの位置
digraph http_bytes_injection {
  graph [
    rankdir=TB, splines=ortho,
    nodesep=0.5, ranksep=0.6, pad=0.25,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white"
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  p1 [label=<<b>経路1</b>：<font face="JetBrains Mono">writeSubset</font> の戻りフック<br align="left"/>アプリのメモリを書き換える<br align="left"/>>,
      fillcolor="#F7DDFC", color="#9430A9"];

  buf [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#736B10">
      <tr><td align="left" bgcolor="#FFFEED"><b><font face="JetBrains Mono">bufio.Writer</font> のバッファ</b>（このまま送られるバイト列）</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">GET /items HTTP/1.1</font></td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">Host: service-b</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">Traceparent: 00-4bf9…-00f0…-01</font>　← OBIが足した1行</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7">（空行。ここでヘッダが終わる）</td></tr>
      <tr><td align="left" bgcolor="#FFF5ED">n ＝ いま使っているバイト数。書き足したぶん進める</td></tr>
    </table>>];

  p2 [label=<<b>経路2</b>：<font face="JetBrains Mono">sk_msg</font> プログラム<br align="left"/>アプリのメモリには触らない<br align="left"/>>,
      fillcolor="#F7DDFC", color="#9430A9"];

  sock [label=<<b>ソケットへ出ていくバイトストリーム</b>>, fillcolor="#E4E4E4"];

  { rank=same; buf; p2; }

  p1 -> buf [penwidth=1.8];
  buf -> sock;
  p2 -> sock [penwidth=1.8];
}
