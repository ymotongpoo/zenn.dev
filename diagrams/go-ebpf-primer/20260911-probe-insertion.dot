// uprobeとuretprobeの挿し込み
digraph probe_insertion {
  graph [
    rankdir=TB, compound=true, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.5, ranksep=0.5,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_u {
    label=<<b>uprobe（スタックには触らない）</b>>;
    fontcolor="#783F0E";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AB5A13"; bgcolor="#FFF5ED";

    code [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
        <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>コード領域 <font face="JetBrains Mono">0x49e180</font></b></td></tr>
        <tr><td align="left" bgcolor="#FFE9D6">差し替え前</td><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">48 01 c0</font></td></tr>
        <tr><td align="left" bgcolor="#FFFCD7">差し替え後</td><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono"><b>cc</b> 01 c0</font></td></tr>
        <tr><td colspan="2" align="left" bgcolor="#FFFFFF"><font point-size="11">CoWでこのプロセスのページだけ</font></td></tr>
      </table>>];
    trap_u [label=<<b>トラップしてカーネルへ</b>>, fillcolor="#FFFCD7", color="#736B10"];
    prog_u [label=<<b>eBPFプログラムが走る</b>>, fillcolor="#FFE9D6", color="#AB5A13"];
    xol [label=<<b>控えた元の命令を実行</b><br align="left"/>カーネルが用意した別領域で<br align="left"/>>,
         fillcolor="#FFFCD7", color="#736B10"];
    next_u [label=<<b>続きの命令へ戻る</b>>, fillcolor="#D2F3DF", color="#038435"];

    code -> trap_u;
    trap_u -> prog_u;
    prog_u -> xol;
    xol -> next_u;
  }

  subgraph cluster_r {
    label=<<b>uretprobe（スタックの値を書き換える）</b>>;
    fontcolor="#7A2C4C";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AA3E6A"; bgcolor="#FEF2F7";

    entry [label=<<b>入口のuprobeが発火</b>>, fillcolor="#FFFCD7", color="#736B10"];
    stack [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
        <tr><td align="left" bgcolor="#FFF5ED"><b>スタック</b></td></tr>
        <tr><td align="left" bgcolor="#FFE9D6">ローカル変数 …</td></tr>
        <tr><td align="left" bgcolor="#FDE1EC">戻りアドレス <b>トランポリン</b><br align="left"/><font color="#7A2C4C" point-size="11">本物の </font><font color="#7A2C4C" point-size="11" face="JetBrains Mono">0x49e1b8</font><font color="#7A2C4C" point-size="11"> はカーネルが退避</font><br align="left"/></td></tr>
      </table>>];
    tramp [label=<<b>トランポリンでトラップ</b>>, fillcolor="#FDE1EC", color="#AA3E6A"];
    prog_r [label=<<b>eBPFプログラムが走る</b>>, fillcolor="#FFE9D6", color="#AB5A13"];
    caller [label=<<b>本物の <font face="JetBrains Mono">0x49e1b8</font> へ</b>>, fillcolor="#E4E4E4"];

    entry -> stack;
    stack -> tramp;
    tramp -> prog_r;
    prog_r -> caller [style=dashed, color="#8A8A8A"];
  }

  { rank=same; code; entry; }
  { rank=same; trap_u; stack; }
  { rank=same; prog_u; tramp; }
  { rank=same; xol; prog_r; }
  { rank=same; next_u; caller; }
}
