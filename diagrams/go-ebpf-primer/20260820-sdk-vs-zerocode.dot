// 誰が traceparent を書き込むのか
digraph sdk_vs_zerocode {
  graph [
    rankdir=TB, compound=true, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.5, ranksep=0.75,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_l {
    label=<<b>SDK計装</b>>;
    fontcolor="#025E26";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#038435"; bgcolor="#EBFAF1";

    appL [label=<<b>アプリのコード</b><br align="left"/>ctx と req を手元に持っている<br align="left"/>>,
          fillcolor="#D2F3DF", color="#038435"];
    hdrL [label=<<b>リクエストのヘッダ</b>>, fillcolor="#E4E4E4"];

    appL -> hdrL;
  }

  subgraph cluster_r {
    label=<<b>ゼロコード計装</b>>;
    fontcolor="#783F0E";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AB5A13"; bgcolor="#FFF5ED";

    appR [label=<<b>アプリのコード</b><br align="left"/>traceparent の存在を知らない<br align="left"/>>,
          fillcolor="#E4E4E4"];
    obiR [label=<<font face="Poppins"><b>OBI</b></font>（カーネル側のフック）>, fillcolor="#FFE9D6", color="#AB5A13"];
    hdrR [label=<<b>リクエストのヘッダ</b>>, fillcolor="#E4E4E4"];

    { rank=same; appR; obiR; }

    appR -> hdrR [style=dashed, color="#AA3E6A", arrowhead=tee];
    obiR -> hdrR [penwidth=1.8];
  }

  { rank=same; appL; appR; obiR; }
  { rank=same; hdrL; hdrR; }
}
