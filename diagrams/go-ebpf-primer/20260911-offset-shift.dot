// バージョン間でオフセットがずれる
digraph offset_shift {
  graph [
    rankdir=TB, splines=ortho,
    nodesep=0.6, ranksep=0.6, pad=0.25,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white"
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  code [label=<<b><font face="JetBrains Mono">+88</font> を読む計装コード</b><br align="left"/>オフセットをハードコード<br align="left"/>>,
        fillcolor="#FFFCD7", color="#736B10"];

  t166 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#038435">
      <tr><td colspan="2" align="left" bgcolor="#EBFAF1"><b><font face="JetBrains Mono">grpc</font> 1.66 の <font face="JetBrains Mono">Stream</font></b></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF">…</td><td align="left" bgcolor="#D2F3DF">…</td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">+88</font></td><td port="p88" align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono"><b>method</b></font></td></tr>
    </table>>];

  t169 [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AA3E6A">
      <tr><td colspan="2" align="left" bgcolor="#FEF2F7"><b><font face="JetBrains Mono">grpc</font> 1.69 の <font face="JetBrains Mono">Stream</font></b>（並びが変わった）</td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">+24</font></td><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono"><b>method</b></font>（本当はここ）</td></tr>
      <tr><td align="left" bgcolor="#FDE1EC">…</td><td align="left" bgcolor="#FDE1EC">…</td></tr>
      <tr><td port="p88" align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">+88</font></td><td align="left" bgcolor="#FDE1EC">別のフィールド</td></tr>
    </table>>];

  crash [label=<<b>クラッシュせず「それらしく動く」</b><br align="left"/>トレースは出るが中身が誤る<br align="left"/>>,
         fillcolor="#FDE1EC", color="#AA3E6A"];

  code -> t166 [penwidth=1.8];
  code -> t169 [style=dashed, color="#AA3E6A"];
  t169 -> crash [style=dashed, color="#AA3E6A"];

  { rank=same; t166; t169; }
}
