// OBIの2つの計装経路
digraph obi_two_paths {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  obi [pos="350,330!", label=<<b>OBI</b>>, fillcolor="#EDF1F5"];

  j  [pos="350,265!", shape=point, width=0.01, style=invis];
  jl [pos="160,265!", shape=point, width=0.01, style=invis];
  jr [pos="545,265!", shape=point, width=0.01, style=invis];

  proto [pos="160,185!", label=<<b>プロトコル計装</b><br align="left"/>ソケットを流れるバイト列を解釈<br align="left"/>HTTP/1.1、HTTP/2、gRPC、MySQL、Redis<br align="left"/>>,
         fillcolor="#D6E8D6", color="#3F6E3F"];
  lib [pos="545,185!", label=<<b>ランタイムとライブラリの計装</b><br align="left"/>対象の環境ごとに個別の実装が要る<br align="left"/>関数計装を持つのはGoだけ<br align="left"/>>,
       fillcolor="#D9E7F4", color="#38638F"];

  proto_res [pos="160,60!", label=<<b>言語に依存しない</b>>, fillcolor="#F0F7F0", color="#3F6E3F"];
  lib_res [pos="545,60!", label=<<b>本書が扱う4つの難所</b><br align="left"/>可動スタック、レジスタABI<br align="left"/>オフセット追従、goroutine<br align="left"/>>,
           fillcolor="#EFF5FB", color="#38638F"];

  obi -> j [dir=none];
  j -> jl [dir=none];
  j -> jr [dir=none];
  jl -> proto;
  jr -> lib [penwidth=1.8];
  proto -> proto_res [style=dashed, color="#7C8DA3"];
  lib -> lib_res [penwidth=1.8];
}
