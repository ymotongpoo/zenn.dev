// ソースから機械語へ、そしてシンボル
digraph source_to_machine {
  graph [
    rankdir=TB, splines=ortho,
    // symtab と insns は rank=same。既定の nodesep(0.25) だと
    // 2つの箱の間の破線矢印が矢じりだけの切れ端に見えるので広げる。
    nodesep=0.8,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  src [label=<<b>Goのソース</b>　<font face="JetBrains Mono">func double(n int) int</font>>, fillcolor="#D2F3DF", color="#038435"];
  bytes [label=<<b>機械語のバイト列</b>　<font face="JetBrains Mono">48 01 c0 c3</font>>, fillcolor="#FFFCD7", color="#736B10"];

  insns [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>命令の並び</b>（1命令ごとにアドレスが付く）</td></tr>
      <tr><td port="head" align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">0x49e180</font></td>
          <td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">ADDQ AX, AX</font></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">0x49e183</font></td>
          <td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">RET</font></td></tr>
    </table>>];

  symtab [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#736B10">
      <tr><td colspan="2" align="left" bgcolor="#FFFEED"><b>シンボルテーブル</b></td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">main.double</font></td>
          <td port="addr" align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">0x49e180</font></td></tr>
    </table>>];

  src -> bytes;
  bytes -> insns;
  symtab:addr:e -> insns:head:w [style=dashed, color="#8A8A8A"];

  { rank=same; symtab; insns; }
}
