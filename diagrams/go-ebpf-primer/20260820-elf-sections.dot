// ELFバイナリの中身と、それを読む側
digraph elf_sections {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    splines=ortho,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  matrix [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#4A4A4A">
      <tr><td align="left" bgcolor="#F3F3F3"><b>ELFのセクション</b></td>
          <td align="left" bgcolor="#F3F3F3"><b>中身</b></td>
          <td align="left" bgcolor="#F5F3FF"><b>デバッガ</b></td>
          <td align="left" bgcolor="#EBFAF1"><font face="Poppins"><b>OBI</b></font></td>
          <td align="left" bgcolor="#EEF4FF"><b>Goランタイム</b></td></tr>
      <tr><td align="left" bgcolor="#E4E4E4"><font face="JetBrains Mono">.text</font></td>
          <td align="left" bgcolor="#FFFFFF">機械語</td>
          <td align="left" bgcolor="#FFFFFF"></td><td align="left" bgcolor="#FFFFFF"></td><td align="left" bgcolor="#FFFFFF"></td></tr>
      <tr><td align="left" bgcolor="#E4E4E4"><font face="JetBrains Mono">.symtab</font></td>
          <td align="left" bgcolor="#FFFFFF">シンボル名とアドレスの対応</td>
          <td align="left" bgcolor="#FFFFFF"></td><td align="left" bgcolor="#D2F3DF">読む</td><td align="left" bgcolor="#FFFFFF"></td></tr>
      <tr><td align="left" bgcolor="#E4E4E4"><font face="JetBrains Mono">.debug_*</font></td>
          <td align="left" bgcolor="#FFFFFF">DWARF（型、フィールド、行番号）</td>
          <td align="left" bgcolor="#E8E3FF">読む</td><td align="left" bgcolor="#D2F3DF">読む</td><td align="left" bgcolor="#FFFFFF"></td></tr>
      <tr><td align="left" bgcolor="#E4E4E4"><font face="JetBrains Mono">.gopclntab</font></td>
          <td align="left" bgcolor="#FFFFFF">Go固有。アドレスと関数、行の対応</td>
          <td align="left" bgcolor="#FFFFFF"></td><td align="left" bgcolor="#D2F3DF">読む</td><td align="left" bgcolor="#D8E5FF">読む</td></tr>
      <tr><td align="left" bgcolor="#E4E4E4">ビルド情報</td>
          <td align="left" bgcolor="#FFFFFF">Goの版と依存モジュール</td>
          <td align="left" bgcolor="#FFFFFF"></td><td align="left" bgcolor="#D2F3DF">読む</td><td align="left" bgcolor="#FFFFFF"></td></tr>
    </table>>];
}
