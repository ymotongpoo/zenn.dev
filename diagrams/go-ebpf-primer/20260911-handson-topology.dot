// ハンズオンの構成（Goの2サービス、OBI、Grafanaスタック）
digraph handson_topology {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.6, ranksep=0.55, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  curl [label=<<b>手元のシェル</b><br align="left"/><font face="JetBrains Mono">curl localhost:8080/order</font><br align="left"/>>,
        fillcolor="#E4E4E4", color="#4A4A4A"];

  subgraph cluster_app {
    label=<<b>計装対象</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AB5A13"; fontcolor="#783F0E"; bgcolor="#FFF5ED";

    frontend [label=<<b>frontend</b>　<font face="JetBrains Mono">:8080</font><br align="left"/><font face="JetBrains Mono">/order</font> のハンドラ<br align="left"/>>,
              fillcolor="#FFE9D6", color="#AB5A13"];
    backend [label=<<b>backend</b>　<font face="JetBrains Mono">:8081</font><br align="left"/><font face="JetBrains Mono">/inventory</font> のハンドラ<br align="left"/>>,
             fillcolor="#FFE9D6", color="#AB5A13"];

    frontend -> backend [constraint=false];
    { rank=same; frontend; backend; }
  }

  obi [label=<<b>obi</b><br align="left"/><font face="JetBrains Mono">otel/ebpf-instrument</font><br align="left"/><font face="JetBrains Mono">privileged</font>、<font face="JetBrains Mono">pid: host</font><br align="left"/>>,
       fillcolor="#F7DDFC", color="#9430A9"];

  subgraph cluster_lgtm {
    label=<<b>Grafanaスタック</b>（<font face="JetBrains Mono">grafana/otel-lgtm</font>。本章で使う4つ）>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#038435"; fontcolor="#025E26"; bgcolor="#EBFAF1";

    collector [label=<<b>OTel Collector</b><br align="left"/>OTLPの受け口　<font face="JetBrains Mono">:4317</font><br align="left"/>>,
               fillcolor="#D2F3DF", color="#038435"];
    tempo [label=<<b>Tempo</b><br align="left"/>トレース<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];
    prom [label=<<b>Prometheus</b><br align="left"/>メトリクス<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];
    grafana [label=<<b>Grafana</b>　<font face="JetBrains Mono">:3000</font><br align="left"/>ブラウザで見る<br align="left"/>>,
             fillcolor="#D2F3DF", color="#038435"];

    collector -> tempo;
    collector -> prom;
    tempo -> grafana;
    prom -> grafana;
    { rank=same; tempo; prom; }
  }

  curl -> frontend;

  // OBI は計装対象の下に置き、上へ2本（観測と書き込み）、下へ1本（OTLP）を出す
  frontend -> obi [style=invis];
  backend -> obi [style=invis];
  obi:nw -> frontend:s [style=dashed, color="#9430A9", constraint=false];
  obi:ne -> backend:s [style=dashed, color="#9430A9", constraint=false];
  obi:s -> collector:n [penwidth=1.8];
}
