// newproc1 の入口と出口で親子を記録する
digraph newproc1_map {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  call [label=<<b><font face="JetBrains Mono">go f()</font> が <font face="JetBrains Mono">runtime.newproc1</font> を呼ぶ</b>>, fillcolor="#E4E4E4"];

  entry [label=<<b>入口のフック</b><br align="left"/>第2引数にある親を控える<br align="left"/>子はまだ存在しない<br align="left"/>>,
         fillcolor="#FFE9D6", color="#AB5A13"];

  tmp [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#736B10">
      <tr><td colspan="2" align="left" bgcolor="#FFFEED"><b><font face="JetBrains Mono">newproc1</font> マップ</b>（一時的な控え）</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7">キー</td><td align="left" bgcolor="#FFFCD7">入口と出口を対応づけるキー</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7">値</td><td align="left" bgcolor="#FFFCD7">親のアドレス</td></tr>
    </table>>];

  ret [label=<<b>出口のフック</b><br align="left"/>戻り値に子のアドレスが入る<br align="left"/>>,
       fillcolor="#FFE9D6", color="#AB5A13"];

  ongoing [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#736B10">
      <tr><td colspan="2" align="left" bgcolor="#FFFEED"><b><font face="JetBrains Mono">ongoing_goroutines</font> マップ</b>（親子の記録）</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7">キー</td><td align="left" bgcolor="#FFFCD7">子のアドレスとPID</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7">値</td><td align="left" bgcolor="#FFFCD7">親のアドレスと時刻</td></tr>
    </table>>];

  call -> entry;
  entry -> tmp [label=" 書く"];
  tmp -> ret [label=" 読む"];
  ret -> ongoing [label=" 親と子を組にして書く", penwidth=1.8];
}
