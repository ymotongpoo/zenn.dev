// eBPFの全体像
digraph ebpf_overview {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  bgU [pos="255,555!", shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#475569",
       label="", width=5.0, height=2.9, fixedsize=true];
  tU [pos="135,640!", shape=plaintext, style="", label=<<b>ユーザー空間</b>>, fontcolor="#334155"];

  bgK [pos="255,205!", shape=box, style="rounded,filled", fillcolor="#F5F1F9", color="#75589C",
       label="", width=5.0, height=4.4, fixedsize=true];
  tK [pos="140,350!", shape=plaintext, style="", label=<<b>カーネル空間</b>>, fontcolor="#5B4370"];

  loader [pos="160,565!", label=<<b>ローダー</b><br align="left"/>Goで書かれる（cilium/ebpf）<br align="left"/>>,
          fillcolor="#D9E7F4", color="#38638F"];
  target [pos="400,480!", label=<<b>計装対象のGoバイナリ</b><br align="left"/>無改変のまま動く<br align="left"/>>,
          fillcolor="#EDF1F5"];

  verifier [pos="160,300!", label=<<b>検証器</b><br align="left"/>停止性とメモリ安全を静的に検査<br align="left"/>>,
            fillcolor="#E9DFF2", color="#75589C"];
  prog [pos="160,190!", label=<<b>eBPFプログラム</b><br align="left"/>イベントごとに実行されて終わる<br align="left"/>>,
        fillcolor="#D9E7F4", color="#38638F"];
  map [pos="160,85!", label=<<b>マップ</b><br align="left"/>イベントをまたぐ状態を持つ<br align="left"/>>,
      fillcolor="#F3E8CE", color="#96742E"];

  u1 [pos="400,565!", shape=point, width=0.01, style=invis];
  LU [pos="335,595!", shape=plaintext, style="", label="uprobeを命令アドレスに置く", fontcolor="#5B6B80"];

  f1 [pos="400,190!", shape=point, width=0.01, style=invis];
  LF [pos="505,330!", shape=plaintext, style="", label="そのアドレスに\n到達すると発火"];

  LV [pos="268,440!", shape=plaintext, style="", label="バイトコードをロード"];
  LP [pos="278,245!", shape=plaintext, style="", label="通れば常駐\n通らなければロード失敗"];
  LM [pos="225,140!", shape=plaintext, style="", label="読み書き"];

  m1 [pos="160,15!", shape=point, width=0.01, style=invis];
  m2 [pos="-15,15!", shape=point, width=0.01, style=invis];
  m3 [pos="-15,565!", shape=point, width=0.01, style=invis];
  LR [pos="80,32!", shape=plaintext, style="", label="マップを読み出す", fontcolor="#5B6B80"];

  loader -> u1 [dir=none, style=dashed, color="#7C8DA3"];
  u1 -> target [style=dashed, color="#7C8DA3"];
  loader -> verifier [penwidth=1.8];
  verifier -> prog [penwidth=1.8];
  prog -> map [dir=both];
  target -> f1 [dir=none, penwidth=1.8];
  f1 -> prog [penwidth=1.8];
  map -> m1 [dir=none, style=dashed, color="#7C8DA3"];
  m1 -> m2 [dir=none, style=dashed, color="#7C8DA3"];
  m2 -> m3 [dir=none, style=dashed, color="#7C8DA3"];
  m3 -> loader [style=dashed, color="#7C8DA3"];
}
