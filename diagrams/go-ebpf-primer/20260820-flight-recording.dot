// flight recording: リングバッファに直近を保持し、問題発生の瞬間に「直前」を取り出す
digraph flight_recording {
  graph [
    rankdir=LR, compound=true, splines=ortho,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    nodesep=0.6, ranksep=0.8,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  runtime [label=<<b>Goランタイム</b><br align="left"/>実行トレースを出し続ける<br align="left"/>（goroutineの切替、GC、syscall …）<br align="left"/>>,
           fillcolor="#D9E7F4", color="#38638F"];

  ring [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#38638F">
      <tr><td colspan="4" align="left" bgcolor="#EFF5FB"><b>リングバッファ（直近ぶんだけを保持）</b></td></tr>
      <tr>
        <td bgcolor="#EDF1F5"><font color="#7C8DA3">古い記録は上書き</font></td>
        <td bgcolor="#D9E7F4">…</td>
        <td bgcolor="#D9E7F4">直近の記録</td>
        <td bgcolor="#F3E8CE"><b>いま</b></td>
      </tr>
    </table>>];

  trigger [label=<<b>問題が起きた瞬間</b><br align="left"/>エラー検知、レイテンシ急増 など<br align="left"/>>,
           fillcolor="#F5DEDE", color="#A04848"];

  snap [label=<<b>FlightRecorder.WriteTo</b><br align="left"/>「直前」の記録だけを書き出す<br align="left"/>>,
        fillcolor="#D6E8D6", color="#3F6E3F"];

  runtime -> ring [xlabel=" 常に記録し続ける"];
  ring -> snap [xlabel=" その瞬間の中身"];
  trigger -> snap [xlabel=" 合図"];

  { rank=same; trigger; ring; }
}
