// ソースから実行までの流れ
digraph source_to_execution {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  src [label=<<b>Goのソースコード</b>>, fillcolor="#D6E8D6", color="#3F6E3F"];
  mc [label=<<b>機械語</b><br align="left"/>4章「ソースコードが実行ファイルになるまで」<br align="left"/>>,
      fillcolor="#F3E8CE", color="#96742E"];
  elf [label=<<b>ELF形式の実行ファイル</b><br align="left"/>4章「ソースコードが実行ファイルになるまで」<br align="left"/>>,
       fillcolor="#F3E8CE", color="#96742E"];
  proc [label=<<b>プロセスとしてメモリに置かれる</b><br align="left"/>3章「OSとカーネル」<br align="left"/>>,
        fillcolor="#D9E7F4", color="#38638F"];
  cpu [label=<<b>CPUがPCの指す命令を実行する</b><br align="left"/>2章「コンピュータはプログラムをどう実行するか」<br align="left"/>>,
       fillcolor="#D9E7F4", color="#38638F"];
  call [label=<<b>関数呼び出しでレジスタとスタックを使う</b><br align="left"/>5章「関数呼び出しの仕組み」<br align="left"/>>,
        fillcolor="#D9E7F4", color="#38638F"];

  src -> mc [label=" コンパイラが変換する"];
  mc -> elf [label=" リンカが1つのファイルにまとめる"];
  elf -> proc [label=" OSが起動する"];
  proc -> cpu [label=" 実行が始まる"];
  cpu -> call [label=" 実行中ずっと繰り返される"];
}
