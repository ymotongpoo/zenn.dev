// ユーザー空間とカーネル空間
digraph user_kernel_space {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.9, ranksep=0.9,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_user {
    label=<<b>ユーザー空間</b>>; labeljust="l"; style="rounded"; penwidth=1.6; margin=14;
    color="#4A4A4A"; fontcolor="#343434"; bgcolor="#F3F3F3";
    app [label=<<b>アプリケーション</b><br align="left"/>Goで書いたプログラムもここで動く<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];
  }

  subgraph cluster_kernel {
    label=<<b>カーネル空間</b>>; labeljust="l"; style="rounded"; penwidth=1.6; margin=14;
    color="#5846B2"; fontcolor="#3E3280"; bgcolor="#F5F3FF";
    kernel [label=<<b>カーネル</b><br align="left"/>ファイル、ネットワーク、メモリを管理する<br align="left"/>>, fillcolor="#E8E3FF", color="#5846B2"];
  }

  hw [label=<<b>ハードウェア</b><br align="left"/>CPU、メモリ、ディスク、ネットワークカード<br align="left"/>>, fillcolor="#E4E4E4"];

  app -> kernel [penwidth=1.8, xlabel=" システムコールで頼む"];
  kernel -> app [style=dashed, color="#8A8A8A", constraint=false, xlabel=" 結果を返す"];
  kernel -> hw [xlabel=" 直接操作する"];
  // このエッジはcluster_kernelをまたぐため splines=ortho の直角配線が崩れ、
  // 単純な斜め線になる（クラスタをまたぐ辺の既知の制約）。1本の素直な斜め線
  // なので「触れない」という意味の破線としては許容する。
  app -> hw [style=dashed, color="#AA3E6A", arrowhead=tee, xlabel=" 直接は触れない"];
}
