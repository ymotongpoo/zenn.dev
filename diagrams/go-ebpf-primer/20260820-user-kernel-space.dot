// ユーザー空間とカーネル空間
digraph user_kernel_space {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  bgU [pos="230,402!", shape=box, style="rounded,filled", fillcolor="#F4F6F8", color="#475569",
       label="", width=6.0, height=1.5, fixedsize=true];
  bgK [pos="230,205!", shape=box, style="rounded,filled", fillcolor="#F5F1F9", color="#75589C",
       label="", width=6.0, height=1.95, fixedsize=true];

  tU [pos="160,437!", shape=plaintext, style="", label=<<b>ユーザー空間</b>（できることが制限される）>, fontcolor="#334155"];
  tK [pos="160,252!", shape=plaintext, style="", label=<<b>カーネル空間</b>（ハードウェアに触れる）>, fontcolor="#5B4370"];

  app [pos="300,383!", label=<<b>アプリケーション</b><br align="left"/>Goで書いたプログラムもここで動く<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];
  kernel [pos="300,180!", label=<<b>カーネル</b><br align="left"/>ファイル、ネットワーク、メモリを管理する<br align="left"/>>, fillcolor="#E9DFF2", color="#75589C"];

  d1 [pos="230,359!", shape=point, width=0.01, style=invis];
  d2 [pos="230,204!", shape=point, width=0.01, style=invis];
  u1 [pos="370,204!", shape=point, width=0.01, style=invis];
  u2 [pos="370,359!", shape=point, width=0.01, style=invis];

  L1 [pos="122,312!", shape=plaintext, style="", label="システムコールで頼む\n（read、write、socket など）"];
  L2 [pos="440,312!", shape=plaintext, style="", label="結果を返す", fontcolor="#5B6B80"];

  hw [pos="300,50!", label=<<b>ハードウェア</b><br align="left"/>CPU、メモリ、ディスク、ネットワークカード<br align="left"/>>, fillcolor="#EDF1F5"];

  r1 [pos="660,383!", shape=point, width=0.01, style=invis];
  r2 [pos="660,50!", shape=point, width=0.01, style=invis];
  L3 [pos="745,222!", shape=plaintext, style="", label="直接は触れない", fontcolor="#7A3030"];

  d1 -> d2 [penwidth=1.8];
  u1 -> u2 [style=dashed, color="#7C8DA3"];
  kernel -> hw [label=" 直接操作する"];
  app -> r1 [dir=none, style=dashed, color="#A04848"];
  r1 -> r2 [dir=none, style=dashed, color="#A04848"];
  r2 -> hw [style=dashed, color="#A04848", arrowhead=tee];
}
