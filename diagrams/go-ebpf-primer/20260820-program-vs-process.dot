// 実行ファイルとプロセス
digraph program_vs_process {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  file [label=<<b>実行ファイル</b><br align="left"/>ディスク上のただのファイル<br align="left"/>>, fillcolor="#FFF0D8", color="#996719"];

  p1 [label=<<b>プロセス（PID 25）</b><br align="left"/>専用の仮想アドレス空間を持つ<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];
  p2 [label=<<b>プロセス（PID 31）</b><br align="left"/>専用の仮想アドレス空間を持つ<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];

  { rank=same; p1; p2; }

  file -> p1;
  file -> p2;
}
