// 実行ファイルとプロセス
digraph program_vs_process {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  file [pos="300,300!", label=<<b>実行ファイル</b><br align="left"/>ディスク上のただのファイル<br align="left"/>>, fillcolor="#F3E8CE", color="#96742E"];

  j  [pos="300,235!", shape=point, width=0.01, style=invis];
  jl [pos="130,235!", shape=point, width=0.01, style=invis];
  jr [pos="470,235!", shape=point, width=0.01, style=invis];

  p1 [pos="130,155!", label=<<b>プロセス（PID 25）</b><br align="left"/>専用の仮想アドレス空間を持つ<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];
  p2 [pos="470,155!", label=<<b>プロセス（PID 31）</b><br align="left"/>専用の仮想アドレス空間を持つ<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];

  L1 [pos="177,197!", shape=plaintext, style="", label="1回目の起動"];
  L2 [pos="517,197!", shape=plaintext, style="", label="2回目の起動"];

  file -> j [dir=none];
  j -> jl [dir=none];
  j -> jr [dir=none];
  jl -> p1;
  jr -> p2;
}
