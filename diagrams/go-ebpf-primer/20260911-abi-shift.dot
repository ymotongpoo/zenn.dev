// Go 1.17 の呼び出し規約の転換
digraph abi_shift {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_old {
    label=<<b>Go 1.16 以前（スタック渡し）</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#4A4A4A"; fontcolor="#343434"; bgcolor="#F3F3F3";

    stack [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#4A4A4A">
        <tr><td colspan="2" align="left" bgcolor="#F3F3F3"><b>スタック</b>（<font face="JetBrains Mono">Add3(1, 2, 3)</font> の呼び出し時）</td></tr>
        <tr><td align="left" bgcolor="#E4E4E4"><font face="JetBrains Mono">SP+0</font></td><td align="left" bgcolor="#E4E4E4">引数 a ＝ 1</td></tr>
        <tr><td align="left" bgcolor="#E4E4E4"><font face="JetBrains Mono">SP+8</font></td><td align="left" bgcolor="#E4E4E4">引数 b ＝ 2</td></tr>
        <tr><td align="left" bgcolor="#E4E4E4" port="p"><font face="JetBrains Mono">SP+16</font></td><td align="left" bgcolor="#E4E4E4">引数 c ＝ 3</td></tr>
      </table>>];
    read_old [label=<<b>外から読む側</b><br align="left"/>SPからの固定オフセットで足りる<br align="left"/>>,
              fillcolor="#D2F3DF", color="#038435"];
    stack -> read_old [label=" 位置が決まっている"];
  }

  subgraph cluster_new {
    label=<<b>Go 1.17 以降（<font face="JetBrains Mono">ABIInternal</font>）</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AB5A13"; fontcolor="#783F0E"; bgcolor="#FFF5ED";

    regs [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
        <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>レジスタ</b>（<font face="JetBrains Mono">Add3(1, 2, 3)</font> の呼び出し時）</td></tr>
        <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">AX</font></td><td align="left" bgcolor="#FFE9D6">引数 a ＝ 1</td></tr>
        <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">BX</font></td><td align="left" bgcolor="#FFE9D6">引数 b ＝ 2</td></tr>
        <tr><td align="left" bgcolor="#FFE9D6" port="p"><font face="JetBrains Mono">CX</font></td><td align="left" bgcolor="#FFE9D6">引数 c ＝ 3</td></tr>
        <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">AX</font></td><td align="left" bgcolor="#D2F3DF">戻り値 ＝ 6（同じAXに戻ってくる）</td></tr>
      </table>>];
    read_new [label=<<b>外から読む側</b><br align="left"/>アーキテクチャ別のレジスタ対応表が要る<br align="left"/>>,
              fillcolor="#FFFCD7", color="#736B10"];
    regs -> read_new [label=" どのレジスタかを\l 知らないと読めない\l"];
  }

  { rank=same; stack; regs; }
}
