// uretprobe による戻りアドレスの書き換え
digraph uretprobe_rewrite {
  graph [
    rankdir=TB, compound=true, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_normal {
    label=<<b>通常の呼び出し</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#4A4A4A"; fontcolor="#343434"; bgcolor="#F3F3F3";

    stack_n [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#AB5A13" bgcolor="#FFE9D6">
        <tr><td align="left">ローカル変数 …</td></tr>
        <tr><td align="left">戻りアドレス <font face="JetBrains Mono"><b>0x49e31f</b></font></td></tr>
      </table>>];
    caller_n [label=<<b>呼び出し元 <font face="JetBrains Mono">0x49e31f</font></b>>, fillcolor="#E4E4E4"];
    stack_n -> caller_n [label=" RET でここへ"];
  }

  subgraph cluster_uret {
    label=<<b>uretprobe 設定後（関数entry時）</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AA3E6A"; fontcolor="#7A2C4C"; bgcolor="#FEF2F7";

    stack_u [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#AB5A13" bgcolor="#FFE9D6">
        <tr><td align="left">ローカル変数 …</td></tr>
        <tr><td align="left" bgcolor="#FDE1EC">戻りアドレス <font face="JetBrains Mono"><b>0xTRAMPOLINE</b></font><br align="left"/><font color="#7A2C4C" point-size="11">← カーネルが書き換えた</font><br align="left"/></td></tr>
      </table>>];
    hook [label=<<b>カーネルのフック</b><br align="left"/>（トランポリン）<br align="left"/>>,
          fillcolor="#FDE1EC", color="#AA3E6A"];
    caller_u [label=<<b>本物の <font face="JetBrains Mono">0x49e31f</font></b>>, fillcolor="#E4E4E4"];

    stack_u -> hook [label=" RET でここへ"];
    hook -> caller_u [label=" 処理後にジャンプし直す", style=dashed, color="#8A8A8A"];
  }

  { rank=same; stack_n; stack_u; }
}
