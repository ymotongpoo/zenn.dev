// uretprobe による戻りアドレスの書き換え
digraph uretprobe_rewrite {
  graph [
    rankdir=TB, compound=true, splines=ortho,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  subgraph cluster_normal {
    label=<<b>通常の呼び出し</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#475569"; fontcolor="#334155"; bgcolor="#F4F6F8";

    stack_n [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#38638F" bgcolor="#D9E7F4">
        <tr><td align="left">ローカル変数 …</td></tr>
        <tr><td align="left">戻りアドレス <b>0x49e31f</b></td></tr>
      </table>>];
    caller_n [label=<<b>呼び出し元 0x49e31f</b>>, fillcolor="#EDF1F5"];
    stack_n -> caller_n [label=" RET でここへ"];
  }

  subgraph cluster_uret {
    label=<<b>uretprobe 設定後（関数entry時）</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#A04848"; fontcolor="#7A3030"; bgcolor="#FBEFEF";

    stack_u [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#38638F" bgcolor="#D9E7F4">
        <tr><td align="left">ローカル変数 …</td></tr>
        <tr><td align="left" bgcolor="#F5DEDE">戻りアドレス <b>0xTRAMPOLINE</b><br align="left"/><font color="#7A3030" point-size="11">← カーネルが書き換えた</font><br align="left"/></td></tr>
      </table>>];
    hook [label=<<b>カーネルのフック</b><br align="left"/>（トランポリン）<br align="left"/>>,
          fillcolor="#F5DEDE", color="#A04848"];
    caller_u [label=<<b>本物の 0x49e31f</b>>, fillcolor="#EDF1F5"];

    stack_u -> hook [label=" RET でここへ"];
    hook -> caller_u [label=" 処理後にジャンプし直す", style=dashed, color="#7C8DA3"];
  }

  { rank=same; stack_n; stack_u; }
}
