// uprobeの挿し込み（スライド基礎編用: uprobe部分のみ）
digraph probe_insertion_uprobe {
  graph [
    rankdir=TB, compound=true, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.5, ranksep=0.5,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_u {
    label=<<font face="Poppins"><b>uprobe</b></font>>;
    fontcolor="#143880";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#1D4EB2"; bgcolor="#EEF4FF";

    code [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#1D4EB2">
        <tr><td colspan="2" align="left" bgcolor="#EEF4FF"><b>コード領域 <font face="JetBrains Mono">0x49e180</font></b></td></tr>
        <tr><td align="left" bgcolor="#D8E5FF">差し替え前</td><td align="left" bgcolor="#D8E5FF"><font face="JetBrains Mono">48 01 c0</font></td></tr>
        <tr><td align="left" bgcolor="#FFF0D8">差し替え後</td><td align="left" bgcolor="#FFF0D8"><font face="JetBrains Mono"><b>cc</b> 01 c0</font></td></tr>
      </table>>];
    trap_u [label=<<b>トラップしてカーネルへ</b><br align="left"/>レジスタ一式を保存<br align="left"/>>, fillcolor="#FFF0D8", color="#996719"];
    prog_u [label=<<b>eBPFプログラムが走る</b><br align="left"/>レジスタの写しを受け取る<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];
    xol [label=<<b>控えた元の命令を実行</b><br align="left"/>カーネルが用意した別領域で<br align="left"/>>,
         fillcolor="#FFF0D8", color="#996719"];
    next_u [label=<<b>続きの命令へ戻る</b>>, fillcolor="#D2F3DF", color="#038435"];

    code -> trap_u;
    trap_u -> prog_u;
    prog_u -> xol;
    xol -> next_u;
  }
}
