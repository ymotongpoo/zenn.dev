// uprobeとuretprobeの挿し込み
digraph probe_insertion {
  graph [
    rankdir=TB, compound=true, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.5, ranksep=0.5,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  subgraph cluster_u {
    label=<<b>uprobe（スタックには触らない）</b>>;
    fontcolor="#2E4D6E";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#38638F"; bgcolor="#EFF5FB";

    code [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#38638F">
        <tr><td colspan="2" align="left" bgcolor="#EFF5FB"><b>コード領域 <font face="JetBrains Mono">0x49e180</font></b></td></tr>
        <tr><td align="left" bgcolor="#D9E7F4">差し替え前</td><td align="left" bgcolor="#D9E7F4"><font face="JetBrains Mono">48 01 c0</font></td></tr>
        <tr><td align="left" bgcolor="#F3E8CE">差し替え後</td><td align="left" bgcolor="#F3E8CE"><font face="JetBrains Mono"><b>cc</b> 01 c0</font></td></tr>
      </table>>];
    trap_u [label=<<b>トラップしてカーネルへ</b>>, fillcolor="#F3E8CE", color="#96742E"];
    prog_u [label=<<b>eBPFプログラムが走る</b>>, fillcolor="#D9E7F4", color="#38638F"];
    xol [label=<<b>控えた元の命令を実行</b><br align="left"/>カーネルが用意した別領域で<br align="left"/>>,
         fillcolor="#F3E8CE", color="#96742E"];
    next_u [label=<<b>続きの命令へ戻る</b>>, fillcolor="#D6E8D6", color="#3F6E3F"];

    code -> trap_u;
    trap_u -> prog_u;
    prog_u -> xol;
    xol -> next_u;
  }

  subgraph cluster_r {
    label=<<b>uretprobe（スタックの値を書き換える）</b>>;
    fontcolor="#7A3030";
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#A04848"; bgcolor="#FBEFEF";

    entry [label=<<b>入口のuprobeが発火</b>>, fillcolor="#F3E8CE", color="#96742E"];
    stack [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#38638F">
        <tr><td align="left" bgcolor="#EFF5FB"><b>スタック</b></td></tr>
        <tr><td align="left" bgcolor="#D9E7F4">ローカル変数 …</td></tr>
        <tr><td align="left" bgcolor="#F5DEDE">戻りアドレス <b>トランポリン</b><br align="left"/><font color="#7A3030" point-size="11">本物の </font><font color="#7A3030" point-size="11" face="JetBrains Mono">0x49e1b8</font><font color="#7A3030" point-size="11"> はカーネルが退避</font><br align="left"/></td></tr>
      </table>>];
    tramp [label=<<b>トランポリンでトラップ</b>>, fillcolor="#F5DEDE", color="#A04848"];
    prog_r [label=<<b>eBPFプログラムが走る</b>>, fillcolor="#D9E7F4", color="#38638F"];
    caller [label=<<b>本物の <font face="JetBrains Mono">0x49e1b8</font> へ</b>>, fillcolor="#EDF1F5"];

    entry -> stack;
    stack -> tramp;
    tramp -> prog_r;
    prog_r -> caller [style=dashed, color="#7C8DA3"];
  }

  { rank=same; code; entry; }
  { rank=same; trap_u; stack; }
  { rank=same; prog_u; tramp; }
  { rank=same; xol; prog_r; }
  { rank=same; next_u; caller; }
}
