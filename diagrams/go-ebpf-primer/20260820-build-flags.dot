// ビルド設定と計装の関係
digraph build_flags {
  graph [
    rankdir=TB, splines=ortho,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  info [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#475569">
      <tr><td align="left" bgcolor="#F4F6F8"><b>バイナリに残るもの</b></td>
          <td align="left" bgcolor="#F0F7F0"><b>通常ビルド</b></td>
          <td align="left" bgcolor="#FBEFEF"><b>-s -w 付き</b></td></tr>
      <tr><td align="left" bgcolor="#EDF1F5">シンボルテーブル</td>
          <td align="left" bgcolor="#D6E8D6">あり</td>
          <td align="left" bgcolor="#F5DEDE">なし</td></tr>
      <tr><td port="pcln" align="left" bgcolor="#EDF1F5">.gopclntab とビルド情報</td>
          <td align="left" bgcolor="#D6E8D6">あり</td>
          <td align="left" bgcolor="#D6E8D6">あり</td></tr>
      <tr><td align="left" bgcolor="#EDF1F5">DWARF</td>
          <td align="left" bgcolor="#D6E8D6">あり</td>
          <td align="left" bgcolor="#F5DEDE">なし</td></tr>
    </table>>];

  addr [label=<<b>関数のアドレスは特定できる</b><br align="left"/>.gopclntab を自前で解析する<br align="left"/>>,
        fillcolor="#D6E8D6", color="#3F6E3F"];
  off_ok [label=<<b>オフセットはバイナリから読める</b>>, fillcolor="#D6E8D6", color="#3F6E3F"];
  off_ng [label=<<b>オフセットは offsets.json 頼み</b><br align="left"/>表に無い版は静かに欠ける<br align="left"/>>,
          fillcolor="#F5DEDE", color="#A04848"];

  { rank=same; addr; off_ok; off_ng; }

  info:pcln:s -> addr [xlabel="どちらでも残る"];
  info -> off_ok [xlabel="DWARFがあれば"];
  info -> off_ng [xlabel="DWARFが無いと"];
}
