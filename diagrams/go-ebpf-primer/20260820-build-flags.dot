// ビルド設定と計装の関係
digraph build_flags {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    ranksep=0.8,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  info [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#4A4A4A">
      <tr><td align="left" bgcolor="#F3F3F3"><b>バイナリに残るもの</b></td>
          <td align="left" bgcolor="#EBFAF1"><b>通常ビルド</b></td>
          <td align="left" bgcolor="#FEF2F7"><b><font face="JetBrains Mono">-s -w</font> 付き</b></td></tr>
      <tr><td align="left" bgcolor="#E4E4E4">シンボルテーブル</td>
          <td align="left" bgcolor="#D2F3DF">あり</td>
          <td align="left" bgcolor="#FDE1EC">なし</td></tr>
      <tr><td align="left" bgcolor="#E4E4E4"><font face="JetBrains Mono">.gopclntab</font> とビルド情報</td>
          <td align="left" bgcolor="#D2F3DF">あり</td>
          <td align="left" bgcolor="#D2F3DF">あり</td></tr>
      <tr><td align="left" bgcolor="#E4E4E4">DWARF</td>
          <td align="left" bgcolor="#D2F3DF">あり</td>
          <td align="left" bgcolor="#FDE1EC">なし</td></tr>
    </table>>];

  addr [label=<<b>関数のアドレスは特定できる</b><br align="left"/><font face="JetBrains Mono">.gopclntab</font> を自前で解析する<br align="left"/>>,
        fillcolor="#D2F3DF", color="#038435"];
  off_ok [label=<<b>オフセットはバイナリから読める</b>>, fillcolor="#D2F3DF", color="#038435"];
  off_ng [label=<<b>オフセットは <font face="JetBrains Mono">offsets.json</font> 頼み</b><br align="left"/>表に無い版は静かに欠ける<br align="left"/>>,
          fillcolor="#FDE1EC", color="#AA3E6A"];

  { rank=same; addr; off_ok; off_ng; }

  info -> addr [xlabel="どちらでも残る"];
  info -> off_ok [xlabel="DWARFがあれば"];
  info -> off_ng [xlabel="DWARFが無いと"];
}
