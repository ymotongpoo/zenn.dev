// CPUは命令を1つずつ実行する
digraph fetch_execute_loop {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  loop [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#475569">
      <tr><td align="left" bgcolor="#F4F6F8"><b>時刻</b></td>
          <td align="left" bgcolor="#F4F6F8"><b>PCの値</b></td>
          <td align="left" bgcolor="#F4F6F8"><b>メモリ（テキスト領域）から取り出して実行する命令</b></td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">時刻1</td>
          <td align="left" bgcolor="#FFFFFF">0x100</td>
          <td align="left" bgcolor="#D6E8D6">0x100 にある命令A（3バイト）。実行してPCを 0x103 へ進める</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">時刻2</td>
          <td align="left" bgcolor="#FFFFFF">0x103</td>
          <td align="left" bgcolor="#D6E8D6">0x103 にある命令B（1バイト）。実行してPCを 0x104 へ進める</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">時刻3</td>
          <td align="left" bgcolor="#FFFFFF">0x104</td>
          <td align="left" bgcolor="#D6E8D6">0x104 にある命令C。同じ繰り返しが続く</td></tr>
    </table>>];
}
