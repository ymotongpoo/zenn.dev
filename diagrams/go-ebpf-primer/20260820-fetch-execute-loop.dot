// CPUは命令を1つずつ実行する
digraph fetch_execute_loop {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];
  rankdir=LR;

  t1 [label=<<b>時刻1</b><br align="left"/>命令Aを実行<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];
  t2 [label=<<b>時刻2</b><br align="left"/>命令Bを実行<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];
  t3 [label=<<b>時刻3</b><br align="left"/>命令Cを実行<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];

  mem [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#475569">
      <tr><td colspan="2" align="left" bgcolor="#F4F6F8"><b>メモリ（テキスト領域）</b></td></tr>
      <tr><td port="a" align="left" bgcolor="#FFFFFF">0x100</td><td align="left" bgcolor="#D6E8D6">命令A</td></tr>
      <tr><td port="b" align="left" bgcolor="#FFFFFF">0x103</td><td align="left" bgcolor="#D6E8D6">命令B</td></tr>
      <tr><td port="c" align="left" bgcolor="#FFFFFF">0x104</td><td align="left" bgcolor="#D6E8D6">命令C</td></tr>
      <tr><td align="left" bgcolor="#FFFFFF">…</td><td align="left" bgcolor="#EDF1F5">…</td></tr>
    </table>>];

  t1 -> t2 -> t3;
  t1 -> mem:a:w [style=dashed, color="#7C8DA3", label=" PCは0x100を指す", fontcolor="#5B6B80"];
  t2 -> mem:b:w [style=dashed, color="#7C8DA3", label=" PCは0x103を指す", fontcolor="#5B6B80"];
  t3 -> mem:c:w [style=dashed, color="#7C8DA3", label=" PCは0x104を指す", fontcolor="#5B6B80"];
}
