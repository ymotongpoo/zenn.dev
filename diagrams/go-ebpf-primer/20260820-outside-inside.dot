// 外からの観測と内からの観測
digraph outside_inside {
  graph [
    layout=neato, inputscale=72, splines=line,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  outside [pos="170,300!", label=<<b>外からの観測：eBPF / OBI</b><br align="left"/>uprobe、レジスタの読み取り、オフセット追従<br align="left"/>>,
           fillcolor="#D9E7F4", color="#38638F"];
  inside [pos="640,300!", label=<<b>内からの観測：Goランタイム</b><br align="left"/>flight recording、goroutine leak profile<br align="left"/>>,
          fillcolor="#D6E8D6", color="#3F6E3F"];

  e1 [pos="170,130!", shape=point, width=0.01, style=invis];
  e2 [pos="640,130!", shape=point, width=0.01, style=invis];
  j  [pos="405,130!", shape=point, width=0.01, style=invis];

  app [pos="405,60!", label=<<b>Goアプリケーション</b>>, fillcolor="#EDF1F5"];

  L1 [pos="238,215!", shape=plaintext, style="", label="アプリ改変は不要\nだが内部構造への\n追従コストを負う"];
  L2 [pos="568,215!", shape=plaintext, style="", label="正確で壊れにくい\nだがコードとビルドへの\n関与が要る"];

  outside -> e1 [dir=none];
  inside -> e2 [dir=none];
  e1 -> j [dir=none];
  e2 -> j [dir=none];
  j -> app;
}
