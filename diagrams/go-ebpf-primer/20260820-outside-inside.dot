// 外からの観測と内からの観測
digraph outside_inside {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  outside [label=<<b>外からの観測：eBPF / OBI</b><br align="left"/>利点：アプリを変更せずに済む<br align="left"/>コスト：内部構造を追いかけ続ける宿命を負う<br align="left"/>>,
           fillcolor="#FFE9D6", color="#AB5A13"];
  inside [label=<<b>内からの観測：Goランタイム</b><br align="left"/>利点：正確で壊れにくい<br align="left"/>コスト：コードやビルドへの関与が要る<br align="left"/>>,
          fillcolor="#D2F3DF", color="#038435"];

  app [label=<<b>Goアプリケーション</b>>, fillcolor="#E4E4E4"];

  { rank=same; outside; inside; }

  outside -> app;
  inside -> app;
}
