// 構造体はメモリ上でどう並ぶか
digraph struct_layout {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];
  ranksep=1.0;

  src [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#038435">
      <tr><td align="left" bgcolor="#EBFAF1"><b>ソースに書いた構造体</b></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">type record struct {</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">&nbsp;&nbsp;&nbsp;&nbsp;flag bool</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">&nbsp;&nbsp;&nbsp;&nbsp;count int64</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">&nbsp;&nbsp;&nbsp;&nbsp;id int32</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono">}</font></td></tr>
    </table>>];

  mem [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>メモリ上の並び</b>（合計24バイト）</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">+0</font></td><td align="left" bgcolor="#FFE9D6">1バイトの値</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">+1 〜 +7</font></td><td align="left" bgcolor="#FFFCD7">詰め物（8バイト境界に合わせる）</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">+8</font></td><td align="left" bgcolor="#FFE9D6">8バイトの値</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">+16</font></td><td align="left" bgcolor="#FFE9D6">4バイトの値</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><font face="JetBrains Mono">+20 〜 +23</font></td><td align="left" bgcolor="#FFFCD7">詰め物</td></tr>
    </table>>];

  src -> mem [label=" コンパイルすると名前は消え、\l バイト位置だけが残る\l", penwidth=1.8];
}
