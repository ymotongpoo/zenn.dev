// インライン展開で消える計装点
digraph inlining {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  before [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>展開されなかった場合</b></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">0x49e1ae</font></td><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">MOVQ …</font></td></tr>
      <tr><td align="left" bgcolor="#D2F3DF" port="call"><font face="JetBrains Mono">0x49e1b3</font></td><td align="left" bgcolor="#D2F3DF"><font face="JetBrains Mono"><b>CALL main.double</b></font>（ここに観測点を置ける）</td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">0x49e1b8</font></td><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">MOVQ …</font></td></tr>
    </table>>];

  after [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AA3E6A">
      <tr><td colspan="2" align="left" bgcolor="#FEF2F7"><b>インライン展開された場合</b></td></tr>
      <tr><td align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">MOVL $0x2a, AX</font></td><td align="left" bgcolor="#FDE1EC">42 に畳み込まれた結果を読み込む</td></tr>
      <tr><td align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">…</font></td><td align="left" bgcolor="#FDE1EC"><font face="JetBrains Mono">CALL main.double</font> がどこにも無い</td></tr>
    </table>>];

  before -> after [label=" コンパイラがインライン展開すると\l CALL が消え、置くアドレスが無くなる\l", penwidth=1.8];
}
