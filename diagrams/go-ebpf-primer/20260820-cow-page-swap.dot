// コピーオンライトによるページの差し替え
digraph cow_page_swap {
  graph [
    rankdir=TB, splines=ortho,
    nodesep=0.7, ranksep=0.7,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  pa [label=<<b>プロセスAの対応表</b>>, fillcolor="#D8E5FF", color="#1D4EB2"];
  pb [label=<<b>プロセスBの対応表</b><br align="left"/>（Bの機械語を書き換えたい）<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];

  orig [label=<<b>共有ページ</b><br align="left"/>変わらない<br align="left"/>>, fillcolor="#D8E5FF", color="#1D4EB2"];
  copy [label=<<b>B専用のコピー</b><br align="left"/>この1ページだけ書き換えた<br align="left"/>>, fillcolor="#FDE1EC", color="#AA3E6A"];

  { rank=same; pa; pb; }
  pa -> pb [style=invis];
  { rank=same; orig; copy; }

  pa -> orig [xlabel="指したまま"];
  pb -> copy [xlabel="差し替わる"];
  orig -> copy [style=dashed, color="#8A8A8A", constraint=false];
}
