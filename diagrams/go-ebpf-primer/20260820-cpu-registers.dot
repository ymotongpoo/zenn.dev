// CPUとレジスタ
digraph cpu_registers {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=ortho,
    nodesep=0.5, ranksep=0.85, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9, labeldistance=3.0,
    fontcolor="#171717"
  ];

  subgraph cluster_cpu {
    label=<<font face="Poppins"><b>CPU</b></font>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#AB5A13"; fontcolor="#783F0E"; bgcolor="#FFF5ED";

    regs [shape=plain, style="", label=<
      <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
        <tr><td colspan="2" align="left" bgcolor="#FFF5ED"><b>レジスタ</b>（CPUの中の小さな入れ物）</td></tr>
        <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">RAX、RBX、RCX …</font></td><td align="left" bgcolor="#FFE9D6">計算に使う汎用レジスタ</td></tr>
        <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">SP</font></td><td align="left" bgcolor="#FFE9D6">スタックの先端のアドレス</td></tr>
        <tr><td align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">PC</font></td><td align="left" bgcolor="#FFE9D6">次に実行する命令のアドレス</td></tr>
      </table>>];
  }

  mem [label=<<b>メモリ</b><br align="left"/>レジスタより桁違いに遅い<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];

  // 往復する2本を splines=ortho で真下・真上の直線にする。ラベルは xlabel だと
  // 2本の間（57.6pt）に収まらず、どちらの矢印のものか読み取れなくなるので、
  // head/tail ラベルを labelangle で各矢印の外側へ振り分ける。
  mem -> regs [taillabel="読み込む", labelangle=-40];
  regs -> mem [headlabel="書き込む", labelangle=40];
}
