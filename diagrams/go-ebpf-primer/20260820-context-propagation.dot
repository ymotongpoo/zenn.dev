// goroutine の親子追跡と traceparent 注入
digraph context_propagation {
  graph [
    rankdir=TB, splines=ortho, compound=true,
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    nodesep=0.7, ranksep=0.7,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  subgraph cluster_svca {
    label=<<b>サービスA（1プロセス）</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#38638F"; fontcolor="#2E4D6E"; bgcolor="#EFF5FB";

    recv [label=<<b>受信 goroutine</b>　トレース開始>, fillcolor="#D9E7F4", color="#38638F"];
    proc [label=<<b>処理 goroutine</b>>, fillcolor="#D9E7F4", color="#38638F"];
    send [label=<<b>送信 goroutine</b><br align="left"/>writeSubset で直列化<br align="left"/>>, fillcolor="#D9E7F4", color="#38638F"];

    recv -> proc [xlabel="newproc1 で親子を記録"];
    proc -> send [xlabel="遡れるのは6段まで"];
  }

  p1 [label=<<b>経路1</b><br align="left"/>bufio.Writer のバッファに<br align="left"/>bpf_probe_write_user で追記<br align="left"/>>,
      fillcolor="#E9DFF2", color="#75589C"];
  p2 [label=<<b>経路2</b><br align="left"/>sk_msg で送出される<br align="left"/>バイト列を伸ばす<br align="left"/>>,
      fillcolor="#E9DFF2", color="#75589C"];
  lock [label=<<b>kernel lockdown / Secure Boot</b>>, fillcolor="#F5DEDE", color="#A04848"];
  svcb [label=<<b>サービスB</b>　traceparent を受け取る>, fillcolor="#EDF1F5"];

  { rank=same; p1; p2; }

  send -> p1;
  send -> p2;
  lock -> p1 [style=dashed, color="#A04848", arrowhead=tee, xlabel="経路1を無効化"];
  p1 -> svcb;
  p2 -> svcb;
}
