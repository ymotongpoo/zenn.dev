// HTTPのバイト列と、traceparent を差し込む2つの位置
digraph http_bytes_injection {
  graph [
    rankdir=TB, splines=ortho,
    nodesep=0.5, ranksep=0.6, pad=0.25,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white"
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  p1 [label=<<b>経路1</b>：<font face="JetBrains Mono">writeSubset</font> の戻りフック<br align="left"/>アプリのメモリを書き換える<br align="left"/>>,
      fillcolor="#E9DFF2", color="#75589C"];

  buf [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#96742E">
      <tr><td align="left" bgcolor="#FAF4E4"><b><font face="JetBrains Mono">bufio.Writer</font> のバッファ</b>（このまま送られるバイト列）</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE"><font face="JetBrains Mono">GET /items HTTP/1.1</font></td></tr>
      <tr><td align="left" bgcolor="#F3E8CE"><font face="JetBrains Mono">Host: service-b</font></td></tr>
      <tr><td align="left" bgcolor="#D6E8D6"><font face="JetBrains Mono">Traceparent: 00-4bf9…-00f0…-01</font>　← OBIが足した1行</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE">（空行。ここでヘッダが終わる）</td></tr>
      <tr><td align="left" bgcolor="#EFF5FB">n ＝ いま使っているバイト数。書き足したぶん進める</td></tr>
    </table>>];

  p2 [label=<<b>経路2</b>：<font face="JetBrains Mono">sk_msg</font> プログラム<br align="left"/>アプリのメモリには触らない<br align="left"/>>,
      fillcolor="#E9DFF2", color="#75589C"];

  sock [label=<<b>ソケットへ出ていくバイトストリーム</b>>, fillcolor="#EDF1F5"];

  { rank=same; buf; p2; }

  p1 -> buf [penwidth=1.8];
  buf -> sock;
  p2 -> sock [penwidth=1.8];
}
