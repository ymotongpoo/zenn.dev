// flight recording: リングバッファに直近を保持し、問題発生の瞬間に「直前」を取り出す
digraph flight_recording {
  graph [
    rankdir=LR, compound=true, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    nodesep=0.6, ranksep=0.8,
    bgcolor="white", pad=0.25, newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  runtime [label=<<b>Goランタイム</b><br align="left"/>実行トレースを出し続ける<br align="left"/>（goroutineの切替、GC、syscall …）<br align="left"/>>,
           fillcolor="#FFE9D6", color="#AB5A13"];

  ring [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#AB5A13">
      <tr><td colspan="4" align="left" bgcolor="#FFF5ED"><b>リングバッファ（直近ぶんだけを保持）</b></td></tr>
      <tr>
        <td bgcolor="#E4E4E4"><font color="#8A8A8A">古い記録は上書き</font></td>
        <td bgcolor="#FFE9D6">…</td>
        <td bgcolor="#FFE9D6">直近の記録</td>
        <td bgcolor="#FFFCD7"><b>いま</b></td>
      </tr>
    </table>>];

  trigger [label=<<b>問題が起きた瞬間</b><br align="left"/>エラー検知、レイテンシ急増 など<br align="left"/>>,
           fillcolor="#FDE1EC", color="#AA3E6A"];

  snap [label=<<font face="JetBrains Mono"><b>FlightRecorder.WriteTo</b></font><br align="left"/>「直前」の記録だけを書き出す<br align="left"/>>,
        fillcolor="#D2F3DF", color="#038435"];

  runtime -> ring [label=" 常に記録し続ける "];
  ring -> snap [label=" その瞬間の中身 "];
  trigger -> snap [label=" 合図 "];

  { rank=same; trigger; ring; }
}
