// メモリは番地の付いたバイトの列
digraph memory_byte_band {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  band [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#4A4A4A">
      <tr>
        <td colspan="8" align="center" bgcolor="#FFE9D6"><font face="JetBrains Mono"><b>int n</b></font>（8バイト）</td>
        <td align="center" bgcolor="#D2F3DF"><font face="JetBrains Mono"><b>byte b</b></font></td>
        <td align="center" bgcolor="#E4E4E4">…</td>
      </tr>
      <tr>
        <td bgcolor="#FFFFFF"><font face="JetBrains Mono">…70</font></td><td bgcolor="#FFFFFF"><font face="JetBrains Mono">…71</font></td><td bgcolor="#FFFFFF"><font face="JetBrains Mono">…72</font></td>
        <td bgcolor="#FFFFFF"><font face="JetBrains Mono">…73</font></td><td bgcolor="#FFFFFF"><font face="JetBrains Mono">…74</font></td><td bgcolor="#FFFFFF"><font face="JetBrains Mono">…75</font></td>
        <td bgcolor="#FFFFFF"><font face="JetBrains Mono">…76</font></td><td bgcolor="#FFFFFF"><font face="JetBrains Mono">…77</font></td><td bgcolor="#FFFFFF"><font face="JetBrains Mono">…78</font></td>
        <td bgcolor="#FFFFFF"><font face="JetBrains Mono">…79</font></td>
      </tr>
      <tr>
        <td colspan="10" align="left" bgcolor="#F3F3F3">下の段が各マスのアドレス（下2桁だけを示した）。1マスが1バイト</td>
      </tr>
    </table>>];
}
