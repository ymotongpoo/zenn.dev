// 親を6段まで遡る
digraph parent_walk {
  graph [
    rankdir=TB, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  cur [label=<<b>送信 goroutine</b>　いまここ>, fillcolor="#FFE9D6", color="#AB5A13"];
  p1 [label=<1段目の親>, fillcolor="#E4E4E4"];
  p2 [label=<2段目の親>, fillcolor="#E4E4E4"];
  dots [label=<…（6段目まで）>, fillcolor="#E4E4E4"];

  root [label=<<b>受信 goroutine</b><br align="left"/><font face="JetBrains Mono">go_trace_map</font> にトレース情報を持つ<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];
  over [label=<<b>7段目で打ち切り</b><br align="left"/>上界の存在は検証器の要請、6という値は実装の選択<br align="left"/>>, fillcolor="#FDE1EC", color="#AA3E6A"];

  { rank=same; root; over; }

  cur -> p1;
  p1 -> p2;
  p2 -> dots;
  dots -> root;
  dots -> over [style=dashed, color="#AA3E6A"];
}
