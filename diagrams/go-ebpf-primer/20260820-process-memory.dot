// プロセスに与えられるメモリ
digraph process_memory {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  mem [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#4A4A4A">
      <tr><td colspan="2" align="left" bgcolor="#F3F3F3"><b>1つのプロセスに見えているメモリ</b>（仮想アドレス空間）</td></tr>
      <tr><td colspan="2" align="left" bgcolor="#FFFFFF"><i>高いアドレス</i></td></tr>
      <tr><td align="left" bgcolor="#FFE9D6"><b>スタック</b></td>
          <td align="left" bgcolor="#FFE9D6">関数の引数とローカル変数。呼び出しで低いアドレスへ伸び、抜けると縮む</td></tr>
      <tr><td align="left" bgcolor="#FFFCD7"><b>ヒープ</b></td>
          <td align="left" bgcolor="#FFFCD7">明示的に確保する領域。関数を抜けても残り、GCが回収する</td></tr>
      <tr><td align="left" bgcolor="#F7DDFC"><b>データ</b></td>
          <td align="left" bgcolor="#F7DDFC">グローバル変数や定数。プログラムの実行中ずっとある</td></tr>
      <tr><td align="left" bgcolor="#D2F3DF"><b>テキスト</b></td>
          <td align="left" bgcolor="#D2F3DF">機械語そのもの。読み取り専用で、命令はここに並ぶ</td></tr>
      <tr><td colspan="2" align="left" bgcolor="#FFFFFF"><i>低いアドレス</i></td></tr>
    </table>>];
}
