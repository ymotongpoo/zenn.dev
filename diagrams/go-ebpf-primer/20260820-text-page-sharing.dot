// 同じ物理ページを共有する2つのプロセス
digraph text_page_sharing {
  graph [
    rankdir=LR, splines=ortho,
    fontname="IBM Plex Sans JP", fontsize=13,
    bgcolor="white", pad=0.25
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  pa [label=<<b>プロセスAの対応表</b><br align="left"/><font face="JetBrains Mono">.text</font> の範囲 → 読み取り専用の印<br align="left"/>>, fillcolor="#FFE9D6", color="#AB5A13"];
  pb [label=<<b>プロセスBの対応表</b><br align="left"/><font face="JetBrains Mono">.text</font> の範囲 → 読み取り専用の印<br align="left"/>>, fillcolor="#D2F3DF", color="#038435"];

  phys [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#4A4A4A">
      <tr><td align="left" bgcolor="#F3F3F3"><b>物理メモリ</b></td></tr>
      <tr><td port="pg" align="left" bgcolor="#FFE9D6"><font face="JetBrains Mono">.text</font> のページ（4KBごと）<br align="left"/>読み取りと実行のみ可<br align="left"/></td></tr>
    </table>>];

  file [label=<<b>実行ファイルの <font face="JetBrains Mono">.text</font></b><br align="left"/>ディスク上。変わらない<br align="left"/>>, fillcolor="#FFFCD7", color="#736B10"];

  pa -> phys:pg:w;
  pb -> phys:w;
  file -> phys [style=dashed, color="#8A8A8A"];

  { rank=same; pa; pb; file; }
}
