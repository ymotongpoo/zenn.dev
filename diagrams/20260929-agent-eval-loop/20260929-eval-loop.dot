// 記事「オブザーバビリティのAIエージェントをどう評価するか」用。
// Evaluate / Learn / Change の3段と、人間が決める位置を示す。
//
// 出典: Yasir Ekinci「Building an evaluation loop for Grafana Assistant」
// "It is a practical loop where AI proposes, benchmarks verify, and humans decide."
//
// 色はブランドパレットに従う。周回の3段は主系列（Orange）、人間の判断は中立（Neutral）。
// 規範: クラスタをまたぐ辺にラベルを付けない（枠線を跨ぐため）。
//
// 戻りの破線は、始点(human)がクラスタ外・終点(evaluate)がクラスタ内のため
// dot は既定では枠の内側を這う経路を引く。対策を2つ重ねている:
//   1. lhead=cluster_auto で破線を枠の外側で止める（内側通過を解消）
//   2. human の左に不可視スペーサーを置き rank=same で human を右へ寄せて、
//      破線が枠から離れた位置を通るようにする（枠との距離 1.2pt → 11.1pt）
// cluster の margin を広げる方法では内側を這う問題が解決しないため使わない。
digraph eval_loop {
  graph [
    fontname="IBM Plex Sans JP", fontsize=13,
    rankdir=TB,
    compound=true, splines=ortho,
    nodesep=0.45, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="IBM Plex Sans JP", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F1F1", color="#4A4A4A", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="IBM Plex Sans JP", fontsize=11,
    color="#343434", penwidth=1.4, arrowsize=0.9,
    fontcolor="#171717"
  ];

  subgraph cluster_auto {
    graph [
      label=<<b>AIが提案する範囲</b>>,
      labeljust="l",
      style="rounded", color="#AB5A13", penwidth=1.6,
      margin=14, bgcolor="#FFF5ED",
      fontcolor="#783F0E"
    ];

    evaluate [
      label=<<b>Evaluate</b><br align="left"/>スイートを実行して証拠を集める<br align="left"/>>,
      fillcolor="#FFE9D6", color="#AB5A13"
    ];
    learn [
      label=<<b>Learn</b><br align="left"/>コーディングエージェントが<br align="left"/>失敗と成功を分析する<br align="left"/>>,
      fillcolor="#FFE9D6", color="#AB5A13"
    ];
    change [
      label=<<b>Change</b><br align="left"/>グレーダーの較正と<br align="left"/>エージェントの改善を提案する<br align="left"/>>,
      fillcolor="#FFE9D6", color="#AB5A13"
    ];

    evaluate -> learn;
    learn -> change;
  }

  spacer [style=invis, shape=point, width=0.4, height=0.01, label=""];

  human [
    label=<<b>人間が決める</b><br align="left"/>採用するか退行として扱うか<br align="left"/>>,
    fillcolor="#E4E4E4", color="#4A4A4A"
  ];

  { rank=same; spacer; human; }
  spacer -> human [style=invis, minlen=0];

  change -> human;
  human -> evaluate [
    style=dashed, color="#8A8A8A", constraint=false,
    lhead=cluster_auto
  ];
}
