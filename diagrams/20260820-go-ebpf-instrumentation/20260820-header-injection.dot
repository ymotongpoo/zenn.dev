// traceparent をどこへ書き込むか
digraph header_injection {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  subgraph cluster_path {
    label=<<b>net/http がリクエストを書き出す経路</b>>;
    style="rounded"; labeljust="l"; penwidth=1.6; margin=14;
    color="#38638F"; fontcolor="#2E4D6E"; bgcolor="#EFF5FB";

    hdr [label=<<b>http.Request.Header</b><br align="left"/>map[string][]string<br align="left"/>>,
         fillcolor="#EDF1F5"];
    ws [label=<<b>Header.writeSubset</b><br align="left"/>ヘッダを文字列にして積む<br align="left"/>>,
        fillcolor="#D9E7F4", color="#38638F"];
    buf [label=<<b>bufio.Writer</b><br align="left"/>buf にバイト列、n に書き込み済みバイト数<br align="left"/>>,
         fillcolor="#F3E8CE", color="#96742E"];
    sock [label=<<b>ソケット</b>>, fillcolor="#EDF1F5"];

    hdr -> ws;
    ws -> buf;
    buf -> sock;
  }

  obi [label=<<b>OBI（writeSubset の戻りフック）</b>>, fillcolor="#E9DFF2", color="#75589C"];

  obi -> hdr [label=" mapに新しいキーは追加できない", style=dashed, color="#A04848", fontcolor="#7A3030", arrowhead=tee];
  obi -> buf [label=" buf の末尾に Traceparent を書き、\l n を進める\l", penwidth=1.8, color="#75589C"];
}
