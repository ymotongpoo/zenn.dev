// newproc1 の入口と出口で親子を記録する
digraph newproc1_map {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  call [label=<<b>go f() が runtime.newproc1 を呼ぶ</b>>, fillcolor="#EDF1F5"];

  entry [label=<<b>入口のフック</b><br align="left"/>第2引数にある親goroutineを控える<br align="left"/>新しいgoroutineはまだ存在しない<br align="left"/>>,
         fillcolor="#D9E7F4", color="#38638F"];

  tmp [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#96742E">
      <tr><td colspan="2" align="left" bgcolor="#FAF4E4"><b>newproc1 マップ</b>（一時的な控え）</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE">キー</td><td align="left" bgcolor="#F3E8CE">呼び出したgoroutine</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE">値</td><td align="left" bgcolor="#F3E8CE">親goroutineのアドレス</td></tr>
    </table>>];

  ret [label=<<b>出口のフック</b><br align="left"/>戻り値に新しいgoroutineのアドレスが入る<br align="left"/>>,
       fillcolor="#D9E7F4", color="#38638F"];

  ongoing [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#96742E">
      <tr><td colspan="2" align="left" bgcolor="#FAF4E4"><b>ongoing_goroutines マップ</b>（親子の記録）</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE">キー</td><td align="left" bgcolor="#F3E8CE">子goroutineのアドレスとPID</td></tr>
      <tr><td align="left" bgcolor="#F3E8CE">値</td><td align="left" bgcolor="#F3E8CE">親goroutineのアドレスと時刻</td></tr>
    </table>>];

  call -> entry;
  entry -> tmp [label=" 書く"];
  tmp -> ret [label=" 読む"];
  ret -> ongoing [label=" 親と子を組にして書く", penwidth=1.8];
}
