// ELFバイナリの中身と、それを読む側
digraph elf_sections {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];
  rankdir=LR;
  ranksep=1.0;

  runtime [label=<<b>Goランタイム</b><br align="left"/>パニック時のスタックトレース<br align="left"/>>,
           fillcolor="#D9E7F4", color="#38638F"];
  debugger [label=<<b>デバッガ</b><br align="left"/>変数名と行番号<br align="left"/>>,
            fillcolor="#E9DFF2", color="#75589C"];
  obi [label=<<b>計装ツール（OBI）</b><br align="left"/>関数の位置とフィールドの位置<br align="left"/>>,
       fillcolor="#D6E8D6", color="#3F6E3F"];

  elf [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#475569">
      <tr><td colspan="2" align="left" bgcolor="#F4F6F8"><b>ELFバイナリのセクション</b></td></tr>
      <tr><td align="left" bgcolor="#EDF1F5">.text</td><td align="left" bgcolor="#EDF1F5">機械語</td></tr>
      <tr><td align="left" bgcolor="#EDF1F5" port="sym">.symtab</td><td align="left" bgcolor="#EDF1F5">シンボル名とアドレスの対応</td></tr>
      <tr><td align="left" bgcolor="#EDF1F5" port="dwarf">.debug_*</td><td align="left" bgcolor="#EDF1F5">DWARF（型、フィールド、行番号）</td></tr>
      <tr><td align="left" bgcolor="#EDF1F5" port="pcln">.gopclntab</td><td align="left" bgcolor="#EDF1F5">Go固有。アドレスと関数、行の対応</td></tr>
      <tr><td align="left" bgcolor="#EDF1F5" port="build">ビルド情報</td><td align="left" bgcolor="#EDF1F5">Goの版と依存モジュール</td></tr>
    </table>>];

  runtime -> elf:pcln:w;
  debugger -> elf:dwarf:w;
  obi -> elf:dwarf:w;
  obi -> elf:pcln:w;
  obi -> elf:build:w;
}
