// 関数呼び出しとスタックフレーム
digraph stack_frame {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  caller [label=<<b>main</b>（呼び出し元）<br align="left"/>0x401050 は Lookup の次の命令<br align="left"/>>,
          fillcolor="#EDF1F5"];
  callee [label=<<b>Lookup</b>（呼び出し先）>, fillcolor="#D9E7F4", color="#38638F"];

  frame [shape=plain, style="", label=<
    <table border="0" cellborder="1" cellspacing="0" cellpadding="7" color="#38638F">
      <tr><td align="left" bgcolor="#EFF5FB"><b>Lookup のスタックフレーム</b></td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">戻りアドレス <b>0x401050</b>（main の次の命令）</td></tr>
      <tr><td align="left" bgcolor="#D9E7F4">ローカル変数</td></tr>
    </table>>];

  caller -> callee [label=" CALL：戻りアドレスを積んでジャンプ", penwidth=1.8];
  callee -> frame [label=" フレームが積まれる", style=dotted, color="#7C8DA3", arrowhead=none];
  callee -> caller [label=" RET：積んだ戻りアドレスへ戻る", penwidth=1.8];
}
