// オフセット解決の2段構え
digraph offset_resolution {
  graph [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=13,
    rankdir=TB, compound=true, splines=true,
    nodesep=0.5, ranksep=0.7, pad=0.25,
    bgcolor="white", newrank=true
  ];
  node [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=12,
    shape=box, style="rounded,filled",
    fillcolor="#F1F5F9", color="#475569", penwidth=1.6,
    margin="0.2,0.14"
  ];
  edge [
    fontname="Harano Aji Gothic,Noto Sans CJK JP,IPAGothic", fontsize=11,
    color="#334155", penwidth=1.4, arrowsize=0.9,
    fontcolor="#1E293B"
  ];

  bin [label=<<b>計装対象のバイナリ</b>>, fillcolor="#EDF1F5"];
  dwarf [label=<<b>DWARFデバッグ情報を読む</b><br align="left"/>コンパイラが書き残したフィールドの位置<br align="left"/>>,
         fillcolor="#D9E7F4", color="#38638F"];
  got [label=<<b>読めたフィールド</b><br align="left"/>目の前のバイナリの事実なので追従が要らない<br align="left"/>>,
       fillcolor="#D6E8D6", color="#3F6E3F"];
  missing [label=<<b>読めなかったフィールド</b>>, fillcolor="#F3E8CE", color="#96742E"];
  table [label=<<b>offsets.json を引く</b><br align="left"/>go-offsets-tracker が自動更新する表<br align="left"/>>,
         fillcolor="#F3E8CE", color="#96742E"];
  ver [label=<<b>ビルド情報から版を割り出す</b><br align="left"/>Goと依存ライブラリのバージョン<br align="left"/>>,
       fillcolor="#F3E8CE", color="#96742E"];
  merged [label=<<b>1つのオフセット表として使う</b>>, fillcolor="#EDF1F5"];
  miss [label=<<b>表にも無ければ、その項目だけ欠ける</b>>, fillcolor="#F5DEDE", color="#A04848"];

  bin -> dwarf;
  dwarf -> got [label=" 取れた分"];
  dwarf -> missing [label=" 欠けた分"];
  bin -> table [label=" DWARFが無い（-w でビルド）\l このときは全項目を表から\l", style=dashed, color="#7C8DA3"];
  missing -> table [label=" 欠けた分だけ補う"];
  table -> ver [label=" どの版でビルドされたかを調べる"];
  got -> merged [penwidth=1.8];
  ver -> merged [penwidth=1.8];
  ver -> miss [label=" 表にその版が無い", style=dashed, color="#A04848", fontcolor="#7A3030"];
}
